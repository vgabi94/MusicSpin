<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- CA1716: VB keyword clashes (Stop/Error) are irrelevant for this C#-only codebase. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>

    <Product>MusicSpin</Product>
    <Authors>Gabriel-Eugen Vaduva</Authors>
    <Copyright>Copyright (c) 2026 Gabriel-Eugen Vaduva</Copyright>
    <!-- With the additional permission for Svg.Custom / SVG.NET (MS-PL) in LICENSE-EXCEPTION.txt. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!--
    Operation markers (ActivitySource + Meter). Independent of Debug/Release.
    Debug defaults on so a local build can capture. Every other configuration, including ordinary Release, defaults off.
    Public packages do not rely on that default: eng/publish.sh and eng/publish.ps1 pass -p:EnablePerfMarkers=false.
    An optimized capture build is: dotnet build -c Release -p:EnablePerfMarkers=true
  -->
  <PropertyGroup>
    <EnablePerfMarkers Condition="'$(EnablePerfMarkers)' == '' AND '$(Configuration)' == 'Debug'">true</EnablePerfMarkers>
    <EnablePerfMarkers Condition="'$(EnablePerfMarkers)' == ''">false</EnablePerfMarkers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
