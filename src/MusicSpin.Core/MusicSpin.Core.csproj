<Project Sdk="Microsoft.NET.Sdk">
  <!-- Playback engine, decoding (FFmpeg) and output (miniaudio through native/msaudio). No UI dependencies. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MusicSpin.Core</RootNamespace>
    <!-- CA1031: catching general exceptions is intentional at native-interop boundaries. -->
    <NoWarn>$(NoWarn);CA1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpeg.AutoGen" />
    <PackageReference Include="LiteDB" />
    <PackageReference Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicSpin.Tests" />
    <InternalsVisibleTo Include="MusicSpin.Tests.Cli" />
    <InternalsVisibleTo Include="MusicSpin.Tests.Ui" />
  </ItemGroup>
  <Import Project="..\..\eng\Native.targets" />
</Project>
