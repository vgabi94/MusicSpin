<!--
  Base animation durations (at Settings › Motion › Smooth) and easings. Views never use these directly: they go through
  the {theming:Motion KeyName} markup extension, which multiplies them by the Motion setting (Theming/Motion.cs).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Hover feedback on navigation and list rows. -->
    <sys:TimeSpan x:Key="HoverDuration">0:0:0.2</sys:TimeSpan>
    <!-- The mini record sliding out of its sleeve in the player bar (mockup: .mini-vinyl, 0.5s). -->
    <sys:TimeSpan x:Key="MiniVinylDuration">0:0:0.5</sys:TimeSpan>
    <!-- An album card's record and cover moving on hover and while it plays (mockup: .card .art > .vinyl, > .cover). -->
    <sys:TimeSpan x:Key="CardVinylDuration">0:0:0.55</sys:TimeSpan>
    <sys:TimeSpan x:Key="CardCoverDuration">0:0:0.45</sys:TimeSpan>
    <!--
      A shelf sleeve turning to face you and its slot widening (mockup: .slot, .sleeve3d, .7s), after the pointer rests
      on it for ShelfHoverDelay (60ms); the playing record sliding half out (.vinyl, 1s after .1s).
    -->
    <sys:TimeSpan x:Key="ShelfTurnDuration">0:0:0.7</sys:TimeSpan>
    <sys:TimeSpan x:Key="ShelfHoverDelay">0:0:0.06</sys:TimeSpan>
    <sys:TimeSpan x:Key="ShelfRecordDuration">0:0:1</sys:TimeSpan>
    <sys:TimeSpan x:Key="ShelfRecordDelay">0:0:0.1</sys:TimeSpan>
    <!-- A crate record flipping (mockup: .crate .rec, transform .8s), its hover light (.35s), the group label (.3s). -->
    <sys:TimeSpan x:Key="CrateFlipDuration">0:0:0.8</sys:TimeSpan>
    <sys:TimeSpan x:Key="CrateHoverDuration">0:0:0.35</sys:TimeSpan>
    <sys:TimeSpan x:Key="CrateLabelDuration">0:0:0.3</sys:TimeSpan>
    <!--
      Now Playing sliding up into place and back down (mockup: .nowplaying, translate .55s, cubic-bezier(.2,.8,.2,1)).
      The deck's tonearm swinging between its rest and the lead-in (rotate .85s, cubic-bezier(.65,0,.35,1)) and
      lowering or lifting (scale and its shadow, .45s, cubic-bezier(.33,0,.2,1)).
    -->
    <sys:TimeSpan x:Key="NowPlayingSlideDuration">0:0:0.55</sys:TimeSpan>
    <sys:TimeSpan x:Key="ArmSwingDuration">0:0:0.85</sys:TimeSpan>
    <sys:TimeSpan x:Key="ArmDropDuration">0:0:0.45</sys:TimeSpan>
    <!-- Now Playing fading in behind the turntable scene instead of sliding (mockup: .nowplaying.scene, opacity .8s ease). -->
    <sys:TimeSpan x:Key="NowPlayingFadeDuration">0:0:0.8</sys:TimeSpan>
    <!-- The queue drawer sliding in from the right and back out (mockup: .queue, translate .45s, cubic-bezier(.2,.8,.2,1)). -->
    <sys:TimeSpan x:Key="QueueSlideDuration">0:0:0.45</sys:TimeSpan>
    <!-- A notice fading in. -->
    <sys:TimeSpan x:Key="BannerDuration">0:0:0.2</sys:TimeSpan>

    <!--
      While a station is on air, the radio icon's waves pulse (mockup: @keyframes onair, 1.8s ease-in-out, infinite); the
      outer pair starts .3s after the inner (.ico .w2 animation-delay). controls:RadioIcon plays it.
    -->
    <sys:TimeSpan x:Key="OnAirPulseDuration">0:0:1.8</sys:TimeSpan>
    <sys:TimeSpan x:Key="OnAirFarDelay">0:0:0.3</sys:TimeSpan>

    <!-- A drag handle growing in on hover (mockup: scale .12s). -->
    <sys:TimeSpan x:Key="HandleDuration">0:0:0.12</sys:TimeSpan>

    <!-- Played by theming:Animate.Play; "<Key>.Duration" is the base duration (Motion scales it). -->
    <!-- A refused typed value (mockup: @keyframes vbad, .3s). -->
    <sys:TimeSpan x:Key="ShakeAnimation.Duration">0:0:0.3</sys:TimeSpan>
    <Animation x:Key="ShakeAnimation" x:SetterTargetType="Visual" Duration="0:0:0.3">
        <KeyFrame Cue="0%">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </KeyFrame>
        <KeyFrame Cue="25%">
            <Setter Property="RenderTransform" Value="translateX(-3px)" />
        </KeyFrame>
        <KeyFrame Cue="75%">
            <Setter Property="RenderTransform" Value="translateX(3px)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </KeyFrame>
    </Animation>
    <!-- The queue's count badge when something was added while the drawer is closed. -->
    <sys:TimeSpan x:Key="PulseAnimation.Duration">0:0:0.4</sys:TimeSpan>
    <Animation x:Key="PulseAnimation" x:SetterTargetType="Visual" Duration="0:0:0.4">
        <KeyFrame Cue="0%">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </KeyFrame>
        <KeyFrame Cue="35%">
            <Setter Property="RenderTransform" Value="scale(1.35)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </KeyFrame>
    </Animation>

    <!-- A row just added to the queue: its accent wash fading out (mockup: @keyframes qflash, 1.6s ease-out). -->
    <sys:TimeSpan x:Key="FlashAnimation.Duration">0:0:1.6</sys:TimeSpan>
    <Animation x:Key="FlashAnimation" x:SetterTargetType="Visual" Duration="0:0:1.6" Easing="0,0,0.58,1">
        <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
        </KeyFrame>
    </Animation>

    <!-- A playlist just saved, in the sidebar: its accent wash fading out (mockup: @keyframes navflash, 1.8s ease-out). -->
    <sys:TimeSpan x:Key="NavFlashAnimation.Duration">0:0:1.8</sys:TimeSpan>
    <Animation x:Key="NavFlashAnimation" x:SetterTargetType="Visual" Duration="0:0:1.8" Easing="0,0,0.58,1">
        <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
        </KeyFrame>
    </Animation>

    <!-- A dialog opening (mockup: @keyframes dlg-in, .18s ease-out: from transparent, 8 px lower, at 98%). -->
    <sys:TimeSpan x:Key="DialogInAnimation.Duration">0:0:0.18</sys:TimeSpan>
    <Animation x:Key="DialogInAnimation" x:SetterTargetType="Visual" Duration="0:0:0.18" Easing="0,0,0.58,1">
        <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translate(0px, 8px) scale(0.98)" />
        </KeyFrame>
        <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
        </KeyFrame>
    </Animation>

    <!-- cubic-bezier(.2,.8,.2,1): quick start, gentle settle. -->
    <SplineEasing x:Key="EaseOut" X1="0.2" Y1="0.8" X2="0.2" Y2="1" />
    <!-- cubic-bezier(.22,1,.36,1): ease-out quint, long gentle settle, no overshoot. -->
    <SplineEasing x:Key="EaseSoft" X1="0.22" Y1="1" X2="0.36" Y2="1" />
    <!-- cubic-bezier(.65,0,.35,1): ease-in-out, the arm swinging. -->
    <SplineEasing x:Key="EaseSwing" X1="0.65" Y1="0" X2="0.35" Y2="1" />
    <!-- cubic-bezier(.33,0,.2,1): the arm lowering. -->
    <SplineEasing x:Key="EaseLower" X1="0.33" Y1="0" X2="0.2" Y2="1" />
    <!-- cubic-bezier(.42,0,.58,1): CSS ease-in-out, the on-air pulse. -->
    <SplineEasing x:Key="EaseInOut" X1="0.42" Y1="0" X2="0.58" Y2="1" />
    <!-- cubic-bezier(.25,.1,.25,1): CSS ease. -->
    <SplineEasing x:Key="Ease" X1="0.25" Y1="0.1" X2="0.25" Y2="1" />
</ResourceDictionary>
