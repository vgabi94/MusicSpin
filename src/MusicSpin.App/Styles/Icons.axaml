<!--
  Icon geometries on a 24×24 grid, drawn by controls:Icon (filled, or stroked with the "stroke" class).
  Icons chosen by key at runtime (sidebar entries) say how they are drawn with a "[key].Stroked" flag.
  The radio waves are the mockup's SVG (index.html, sidebar).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <StreamGeometry x:Key="Icon.Albums">F0 M12,3 A9,9 0 1 1 11.99,3 Z M12,9.6 A2.4,2.4 0 1 0 12.01,9.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Tracks">M9,17.5 A3,3 0 1 1 7,14.67 V5.2 L18,3 V14.5 A3,3 0 1 1 16,11.67 V6.2 L9,7.6 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Radio">M14.2,12 A2.2,2.2 0 1 1 9.8,12 A2.2,2.2 0 1 1 14.2,12 Z M8.5,8.5 A5,5 0 0 0 8.5,15.5 M15.5,8.5 A5,5 0 0 1 15.5,15.5 M5.6,5.6 A9,9 0 0 0 5.6,18.4 M18.4,5.6 A9,9 0 0 1 18.4,18.4</StreamGeometry>
    <StreamGeometry x:Key="Icon.Playlist">M4,6 H16 M4,11 H16 M4,16 H11 M17,14 V20 M14,17 H20</StreamGeometry>
    <sys:Boolean x:Key="Icon.Radio.Stroked">True</sys:Boolean>
    <sys:Boolean x:Key="Icon.Playlist.Stroked">True</sys:Boolean>
    <StreamGeometry x:Key="Icon.Search">M10.5,4 A6.5,6.5 0 1 1 10.5,17 A6.5,6.5 0 1 1 10.5,4 Z M15.5,15.5 L20,20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</StreamGeometry>
    <!-- Window buttons, thin like the mockup's .winctl glyphs (drawn stroked). -->
    <StreamGeometry x:Key="Icon.Minimize">M2,12 H22</StreamGeometry>
    <StreamGeometry x:Key="Icon.Maximize">M2,2 H22 V22 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Restore">M2,7 H17 V22 H2 Z M7,7 V2 H22 V17 H17</StreamGeometry>
    <StreamGeometry x:Key="Icon.WindowClose">M2,2 L22,22 M22,2 L2,22</StreamGeometry>
    <StreamGeometry x:Key="Icon.Play">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M6.5,5 H10 V19 H6.5 Z M14,5 H17.5 V19 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Previous">M6,5 H8 V19 H6 Z M19,5 L9,12 L19,19 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Next">M16,5 H18 V19 H16 Z M5,5 L15,12 L5,19 Z</StreamGeometry>
</ResourceDictionary>
