<!--
  Colour tokens, from the mockup's CSS variables (docs/design/mockup/styles.css, "Theme").
  Theme-dependent brushes live in the Dark and Light dictionaries: use them with DynamicResource so a theme switch
  applies live. AccentBrush / AccentInkBrush are defaults; the app replaces them per playing album (Theming/Appearance.cs).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgBrush" Color="#0E0F12" />
            <SolidColorBrush x:Key="Bg2Brush" Color="#15171C" />
            <SolidColorBrush x:Key="Bg3Brush" Color="#1D2027" />
            <SolidColorBrush x:Key="LineBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="FgBrush" Color="#EEF0F4" />
            <SolidColorBrush x:Key="Fg2Brush" Color="#9AA1AD" />
            <SolidColorBrush x:Key="BannerBrush" Color="#33E8A03C" />
            <SolidColorBrush x:Key="PlaceholderBrush" Color="#2A2E37" />
            <SolidColorBrush x:Key="PlaceholderInkBrush" Color="#C9CED8" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="MenuHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#1AFFFFFF" />
            <Color x:Key="CardShadowColor">#CC000000</Color>
            <!-- The Classic deck's plinth (mockup: .deck, linear-gradient(160deg, …)). -->
            <LinearGradientBrush x:Key="DeckPlinthBrush" StartPoint="33%,0%" EndPoint="67%,100%">
                <GradientStop Color="#2A2C31" Offset="0" />
                <GradientStop Color="#17181B" Offset="1" />
            </LinearGradientBrush>
            <!-- A shelf board (mockup: .board, linear-gradient(#3a2c22, #2a1f18 40%, #1a130e)). -->
            <LinearGradientBrush x:Key="ShelfBoardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#3A2C22" Offset="0" />
                <GradientStop Color="#2A1F18" Offset="0.4" />
                <GradientStop Color="#1A130E" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgBrush" Color="#F4F2EE" />
            <SolidColorBrush x:Key="Bg2Brush" Color="#EBE8E2" />
            <SolidColorBrush x:Key="Bg3Brush" Color="#DFDBD3" />
            <SolidColorBrush x:Key="LineBrush" Color="#14000000" />
            <SolidColorBrush x:Key="FgBrush" Color="#1B1C1F" />
            <SolidColorBrush x:Key="Fg2Brush" Color="#6C6F76" />
            <SolidColorBrush x:Key="BannerBrush" Color="#33C0782A" />
            <SolidColorBrush x:Key="PlaceholderBrush" Color="#D3CEC5" />
            <SolidColorBrush x:Key="PlaceholderInkBrush" Color="#4A4C52" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="MenuHoverBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14000000" />
            <Color x:Key="CardShadowColor">#66000000</Color>
            <LinearGradientBrush x:Key="DeckPlinthBrush" StartPoint="33%,0%" EndPoint="67%,100%">
                <GradientStop Color="#F7F5F1" Offset="0" />
                <GradientStop Color="#DCD8D0" Offset="1" />
            </LinearGradientBrush>
            <!-- mockup: :root.light .board, linear-gradient(#c9a77f, #b48f66 40%, #8f6d4b). -->
            <LinearGradientBrush x:Key="ShelfBoardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#C9A77F" Offset="0" />
                <GradientStop Color="#B48F66" Offset="0.4" />
                <GradientStop Color="#8F6D4B" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- The playing album's colour (80% with white) and its ink for text; replaced at runtime. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E86A3C" />
    <SolidColorBrush x:Key="AccentInkBrush" Color="#E86A3C" />

    <!-- A sleeve's spine when the album has no colour (mockup: .edge, background #333 by default). -->
    <SolidColorBrush x:Key="ShelfSpineBrush" Color="#333333" />
    <!-- A sleeve's contact shadow on the board (mockup: .sleeve3d::after, radial-gradient(closest-side, #000a, transparent)). -->
    <RadialGradientBrush x:Key="ShelfShadowBrush">
        <GradientStop Color="#AA000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </RadialGradientBrush>
    <!-- The crate (mockup: .crate-box, linear-gradient(#5a4232, #3b2a1f)); the same in both themes. -->
    <LinearGradientBrush x:Key="CrateBoxBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#5A4232" Offset="0" />
        <GradientStop Color="#3B2A1F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CrateLabelBrush" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CrateGroupLabelBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="CrateActiveLabelBrush" Color="#FFFFFF" />
    <!-- A crate record's hover light (mockup: .crate .rec::after, #fff at .07). -->
    <SolidColorBrush x:Key="CrateRecordHoverBrush" Color="#FFFFFF" />
    <!-- The records behind darken: black over them (mockup: filter: brightness). -->
    <SolidColorBrush x:Key="CrateShadeBrush" Color="#000000" />
    <!-- A format chip (mockup: .np-tech span, background #ffffff14). -->
    <SolidColorBrush x:Key="ChipBrush" Color="#14FFFFFF" />

    <!-- Records and sleeves look the same in both themes. -->
    <SolidColorBrush x:Key="VinylBrush" Color="#111111" />
    <SolidColorBrush x:Key="VinylGrooveBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="VinylEdgeBrush" Color="#000000" />
    <SolidColorBrush x:Key="VinylHoleBrush" Color="#050505" />
    <SolidColorBrush x:Key="VinylHoleRimBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="VinylLabelRimBrush" Color="#88000000" />
    <SolidColorBrush x:Key="BrandDiscBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="BrandDiscGrooveBrush" Color="#222222" />
    <Color x:Key="VinylSheenColor">#26FFFFFF</Color>
    <!-- The sleeve's paper sheen (mockup: .cover::after, linear-gradient(125deg, …)). -->
    <LinearGradientBrush x:Key="CoverSheenBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#22FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.35" />
        <GradientStop Color="#00000000" Offset="0.7" />
        <GradientStop Color="#30000000" Offset="1" />
    </LinearGradientBrush>
    <!-- A track thumbnail while hovered: dimmed under a white ▶ (mockup: .tr .lead::after). -->
    <SolidColorBrush x:Key="ThumbOverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="ThumbOverlayInkBrush" Color="#FFFFFF" />
    <!-- Text and icons on an accent fill (the mockup's black on the accent). -->
    <SolidColorBrush x:Key="OnAccentBrush" Color="#000000" />
    <!-- The HI-RES badge (mockup: .hires) and a refused typed value (mockup: .bad). -->
    <SolidColorBrush x:Key="HiResBrush" Color="#D4B25A" />
    <SolidColorBrush x:Key="InvalidBrush" Color="#E5484D" />
    <!-- The close window button while hovered (the platform convention). -->
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E81123" />
    <SolidColorBrush x:Key="CloseHoverInkBrush" Color="#FFFFFF" />
    <!-- Behind a dialog: a light dim, so what it changes stays visible (mockup: .dlg-back, #0006). -->
    <SolidColorBrush x:Key="DialogBackdropBrush" Color="#66000000" />
    <!-- The Classic deck's platter, its rim and the arm (mockup: .platter, .arm-base, .arm, .headshell). -->
    <SolidColorBrush x:Key="DeckPlatterBrush" Color="#33363C" />
    <SolidColorBrush x:Key="DeckPlatterRingBrush" Color="#66000000" />
    <RadialGradientBrush x:Key="DeckArmBaseBrush">
        <GradientStop Color="#D8D8D8" Offset="0.22" />
        <GradientStop Color="#888888" Offset="0.24" />
        <GradientStop Color="#888888" Offset="0.40" />
        <GradientStop Color="#444444" Offset="0.42" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="DeckArmBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#8D8D8D" Offset="0" />
        <GradientStop Color="#EEEEEE" Offset="0.5" />
        <GradientStop Color="#8D8D8D" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DeckHeadshellBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#555555" Offset="0" />
        <GradientStop Color="#AAAAAA" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
