<!--
  Control themes shared by every area: a plain button (no Fluent chrome; areas style it with classes), the bar you drag,
  the scroll bars, the box you type a value into, the search text box, a segmented control, a list of cards and Settings'
  list of pages. Merged into the application resources.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MusicSpin.App.Controls"
                    xmlns:theming="using:MusicSpin.App.Theming"
                    xmlns:vm="using:MusicSpin.App.ViewModels">
    <!-- The default look of every Button (no Fluent chrome); areas style it with classes. Being the implicit theme, it
         never overrides a theme set on purpose, like the window buttons in Window.axaml. -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- Always hit-testable, even while a background transition starts from no brush. -->
                <Panel Background="Transparent">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- A bar you drag (mockup: .bar, .vbar): the line, its fill in Foreground, a handle on hover, drag and keyboard
         focus, and a focus outline. PART_Tip, the time over the pointer, shows only where a style turns it on. -->
    <ControlTheme x:Key="{x:Type controls:ScrubBar}" TargetType="controls:ScrubBar">
        <Setter Property="Height" Value="{StaticResource ScrubBarHeight}" />
        <!-- A templated control clips to its bounds, which would cut off the half of the handle past either end at 0 and
             at the maximum. Neighbours leave the handle's radius free (ProgressGap, VolumeGap). -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="PART_FocusRing"
                            Margin="{StaticResource FocusRingMargin}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="{StaticResource FocusRingRadius}"
                            IsVisible="False" />
                    <Border Name="PART_Line"
                            Height="{StaticResource ScrubLineHeight}"
                            CornerRadius="{StaticResource ScrubLineRadius}"
                            Background="{DynamicResource Bg3Brush}"
                            VerticalAlignment="Center" />
                    <Border Name="PART_Fill"
                            Width="{TemplateBinding FillWidth}"
                            Height="{StaticResource ScrubLineHeight}"
                            CornerRadius="{StaticResource ScrubLineRadius}"
                            Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />
                    <Canvas>
                        <Border Name="PART_Handle"
                                Canvas.Left="{TemplateBinding FillWidth}"
                                Width="{StaticResource ScrubHandleSize}"
                                Height="{StaticResource ScrubHandleSize}"
                                Margin="{StaticResource ScrubHandleMargin}"
                                CornerRadius="{StaticResource ScrubHandleRadius}"
                                Background="{DynamicResource FgBrush}"
                                BoxShadow="0 1 3 0 #88000000"
                                RenderTransform="scale(0)"
                                theming:Animate.Transitions="RenderTransform HandleDuration" />
                        <Border Name="PART_Tip"
                                Canvas.Left="{TemplateBinding TipLeft}"
                                Canvas.Bottom="{StaticResource PositionTipBottom}"
                                Padding="{StaticResource PositionTipPadding}"
                                CornerRadius="{StaticResource PositionTipRadius}"
                                Background="{DynamicResource FgBrush}"
                                IsHitTestVisible="False"
                                IsVisible="False">
                            <TextBlock Name="PART_TipText"
                                       Foreground="{DynamicResource BgBrush}"
                                       FontSize="{StaticResource PositionTipFontSize}"
                                       FontWeight="SemiBold"
                                       Text="{Binding HoverValue, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static theming:TextConverters.Clock}}" />
                        </Border>
                    </Canvas>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Handle">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:dragging /template/ Border#PART_Handle">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Handle">
            <Setter Property="RenderTransform" Value="scale(1)" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!--
      Scroll bars (#130), in place of Fluent's: every ScrollViewer's bars, over the content's edge. A slim rounded thumb and
      no arrow buttons; clicking beside the thumb pages. The thumb is lighter under the pointer and takes the accent while
      dragged. Every change is a brush, an opacity or a render transform, so it animates without a layout pass.
    -->
    <ControlTheme x:Key="ScrollBarThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The whole bar's width takes the pointer; the pill inside it is what shows. -->
                <Panel Background="Transparent">
                    <Border Name="PART_Pill"
                            Margin="{StaticResource ScrollThumbInset}"
                            CornerRadius="{StaticResource ScrollThumbRadius}"
                            Background="{TemplateBinding Background}"
                            theming:Animate.Transitions="Background HoverDuration" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
        </Style>
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </ControlTheme>

    <!-- Either side of the thumb: invisible, a click there pages. -->
    <ControlTheme x:Key="ScrollBarPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="MinWidth" Value="{StaticResource ScrollBarSize}" />
        <Setter Property="MinHeight" Value="{StaticResource ScrollBarSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Style Selector="^:vertical">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Border Name="PART_TrackFill"
                                Margin="{StaticResource ScrollThumbInset}"
                                CornerRadius="{StaticResource ScrollThumbRadius}"
                                Background="{DynamicResource ScrollTrackBrush}"
                                Opacity="0"
                                theming:Animate.Transitions="Opacity ScrollBarExpandDuration" />
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPage}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPage}" />
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb"
                                   Theme="{StaticResource ScrollBarThumb}"
                                   Width="{StaticResource ScrollBarSize}"
                                   MinHeight="{StaticResource ScrollThumbMinLength}"
                                   RenderTransform="scaleX(0.5)"
                                   RenderTransformOrigin="100%,50%"
                                   AutomationProperties.Name="Position"
                                   theming:Animate.Transitions="RenderTransform ScrollBarExpandDuration" />
                        </Track>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="{TemplateBinding Background}">
                        <Border Name="PART_TrackFill"
                                Margin="{StaticResource ScrollThumbInset}"
                                CornerRadius="{StaticResource ScrollThumbRadius}"
                                Background="{DynamicResource ScrollTrackBrush}"
                                Opacity="0"
                                theming:Animate.Transitions="Opacity ScrollBarExpandDuration" />
                        <Track Name="PART_Track"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}"
                               DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                               ViewportSize="{TemplateBinding ViewportSize}"
                               Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseButton>
                                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPage}" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPage}" />
                            </Track.IncreaseButton>
                            <Thumb Name="PART_Thumb"
                                   Theme="{StaticResource ScrollBarThumb}"
                                   Height="{StaticResource ScrollBarSize}"
                                   MinWidth="{StaticResource ScrollThumbMinLength}"
                                   RenderTransform="scaleY(0.5)"
                                   RenderTransformOrigin="50%,100%"
                                   AutomationProperties.Name="Position"
                                   theming:Animate.Transitions="RenderTransform ScrollBarExpandDuration" />
                        </Track>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- Under the pointer (after the bar's ShowDelay, until its HideDelay after it leaves), and always when the
             ScrollViewer doesn't auto-hide its bars: the whole thumb and the track. -->
        <Style Selector="^[IsExpanded=true] /template/ Thumb#PART_Thumb">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="^[IsExpanded=true] /template/ Border#PART_TrackFill">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:disabled /template/ Thumb#PART_Thumb">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <!-- A value you can type into (mockup: .tnum, .vnum): plain text until hovered, an accent outline while editing, a
         red one when a value is refused. -->
    <ControlTheme x:Key="TypedBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Panel>
                        <!-- Only where a box sets PlaceholderText (the equalizer's preset name). -->
                        <TextBlock Name="PART_Watermark"
                                   Text="{TemplateBinding PlaceholderText}"
                                   Foreground="{DynamicResource Fg2Brush}"
                                   VerticalAlignment="Center"
                                   IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        <ScrollViewer Name="PART_ScrollViewer"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled">
                            <TextPresenter Name="PART_TextPresenter"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBrush="{TemplateBinding CaretBrush}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding Foreground}"
                                           TextAlignment="{TemplateBinding TextAlignment}"
                                           TextWrapping="NoWrap"
                                           VerticalAlignment="Center" />
                        </ScrollViewer>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^.invalid">
            <Setter Property="BorderBrush" Value="{StaticResource InvalidBrush}" />
        </Style>
    </ControlTheme>

    <!-- One option of a segmented control (mockup: .seg button): Fg2, or raised on Bg3 when chosen. -->
    <ControlTheme x:Key="SegmentedItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource SegmentBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SegmentRadius}" />
        <Setter Property="Padding" Value="{StaticResource SegmentPadding}" />
        <Setter Property="FontSize" Value="{StaticResource SegmentFontSize}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Label}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Segment"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Segment">
            <Setter Property="BoxShadow" Value="0 1 2 0 #55000000" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!--
      A switch (Settings' Watch folders and Exclusive mode; the mockup has none): a round-ended track, the panel colour when
      off and the accent when on, with its knob at the start or the end. Space toggles it when it has the focus.
    -->
    <ControlTheme x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource SwitchWidth}" />
        <Setter Property="Height" Value="{StaticResource SwitchHeight}" />
        <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SwitchRadius}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="theming:Animate.Transitions" Value="Background HoverDuration" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <Ellipse Name="PART_Knob"
                             Width="{StaticResource SwitchKnobSize}"
                             Height="{StaticResource SwitchKnobSize}"
                             Margin="{StaticResource SwitchKnobMargin}"
                             Fill="{TemplateBinding Foreground}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Ellipse#PART_Knob">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.45" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </ControlTheme>

    <!-- A segmented control (mockup: .seg): a ListBox of Choice records, one always chosen; arrows move the choice. -->
    <ControlTheme x:Key="Segmented" TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SegmentedBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource SegmentedRadius}" />
        <Setter Property="Padding" Value="{StaticResource SegmentedPadding}" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SegmentedItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="vm:Choice">
                <TextBlock Text="{Binding Label}" />
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A card in a row of pictures to choose from (Settings › Turntable › Design): an accent ring when chosen. -->
    <ControlTheme x:Key="CardItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource DesignCardBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource DesignCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource DesignCardPadding}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Name}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_FocusRing"
                            Margin="{StaticResource FocusRingMargin}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsVisible="False" />
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Border Name="PART_Chosen"
                            BorderThickness="{StaticResource DesignCardSelectedThickness}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#PART_Chosen">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- Cards in a row that wraps, one always chosen. -->
    <ControlTheme x:Key="Cards" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource CardItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel ItemSpacing="{StaticResource DesignCardGap}" LineSpacing="{StaticResource DesignCardGap}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!--
      A page of Settings in its sidebar (#188): drawn like the window's sidebar entries (Sidebar.axaml, Button.nav), the
      chosen one on the Bg3 pill; an accent ring inside the entry when the keyboard is on it. A page that couldn't load
      has a "!" at the end.
    -->
    <ControlTheme x:Key="SettingsNavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource NavItemPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource NavItemRadius}" />
        <Setter Property="FontSize" Value="{StaticResource NavFontSize}" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="AutomationProperties.Name" Value="{ReflectionBinding Title}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                    <Border Name="PART_FocusRing"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- Settings' pages (#188), one under the other, one always chosen; ↑ ↓ Home End move the choice. -->
    <ControlTheme x:Key="SettingsNav" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource SettingsNavItem}" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{StaticResource SettingsNavSpacing}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="vm:SettingsPage">
                <Grid Classes="settingsEntry" ColumnDefinitions="Auto,*,Auto">
                    <controls:Icon Data="{Binding Icon, Converter={x:Static theming:IconConverters.Geometry}}"
                                   IsStroked="{Binding Icon, Converter={x:Static theming:IconConverters.IsStroked}}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" />
                    <TextBlock Grid.Column="2" Classes="pageProblem" Text="!" IsVisible="{Binding HasProblem}" />
                </Grid>
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <TextBlock Name="PART_Watermark"
                               Text="{TemplateBinding PlaceholderText}"
                               Foreground="{DynamicResource Fg2Brush}"
                               VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding Foreground}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="NoWrap"
                                       VerticalAlignment="Center" />
                    </ScrollViewer>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
