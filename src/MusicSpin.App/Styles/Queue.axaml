<!--
  The queue drawer (mockup: "Queue drawer", .queue): it slides in from the right over the content, under the player bar.
  Rows show ✕ on hover, a fresh row flashes in the accent, a dragged row fades; while something is dragged over the
  drawer the drop line shows between rows, or the empty box lights up. The radio station's next picks are dimmed.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MusicSpin.App.Controls"
        xmlns:views="using:MusicSpin.App.Views"
        xmlns:theming="using:MusicSpin.App.Theming">
    <Style Selector="controls|SlidePanel.queue">
        <Setter Property="Edge" Value="Right" />
        <Setter Property="Width" Value="{StaticResource QueueWidth}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="theming:Animate.Transitions" Value="Shown QueueSlideDuration EaseOut" />
    </Style>
    <Style Selector="Border.queueDrawer">
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineLeft}" />
        <Setter Property="BoxShadow" Value="-30 0 50 -30 #CC000000" />
    </Style>

    <!-- The header: "Up next", the summary, Clear (hidden while empty) and ✕. -->
    <Style Selector="Grid.queueHeader">
        <Setter Property="Margin" Value="{StaticResource QueueHeaderPadding}" />
        <Setter Property="ColumnSpacing" Value="{StaticResource QueueHeaderGap}" />
    </Style>
    <Style Selector="StackPanel.queueHeading">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource QueueHeaderGap}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.queueTitle">
        <Setter Property="FontSize" Value="{StaticResource QueueTitleFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style Selector="TextBlock.queueSummary">
        <Setter Property="FontSize" Value="{StaticResource QueueSummaryFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- Clear and End radio (mockup: .qclear, .qradio-h button). -->
    <Style Selector="Button.queueClear">
        <Setter Property="Padding" Value="{StaticResource QueueTextButtonPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueTextButtonRadius}" />
        <Setter Property="FontSize" Value="{StaticResource QueueTextButtonFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.queueClear:pointerover, Button.queueClose:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="views|QueueDrawerView.empty Button#ClearQueue">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.queueClose">
        <Setter Property="Width" Value="{StaticResource QueueCloseSize}" />
        <Setter Property="Height" Value="{StaticResource QueueCloseSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueCloseRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.queueClose controls|Icon">
        <Setter Property="Width" Value="{StaticResource QueueCloseIconSize}" />
        <Setter Property="Height" Value="{StaticResource QueueCloseIconSize}" />
    </Style>

    <Style Selector="ScrollViewer.queueScroll">
        <Setter Property="Padding" Value="{StaticResource QueueListPadding}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- A row (mockup: .qi): the whole of it skips to it; ✕ over its last column shows on hover. -->
    <Style Selector="Panel.queueRow">
        <Setter Property="TextElement.FontSize" Value="{StaticResource QueueRowFontSize}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Panel.queueRow.dragged">
        <Setter Property="Opacity" Value="{StaticResource QueueDraggedOpacity}" />
    </Style>
    <Style Selector="Panel.queueRow > Border.flash">
        <Setter Property="CornerRadius" Value="{StaticResource QueueRowRadius}" />
        <Setter Property="Background" Value="{DynamicResource AccentFlashBrush}" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.queueEntry">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource QueueRowPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueRowRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Panel.queueRow:pointerover Button.queueEntry">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="Button.queueEntry > Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource QueueRowGap}" />
    </Style>
    <Style Selector="Button.queueEntry controls|CoverView">
        <Setter Property="Width" Value="{StaticResource RowThumbSize}" />
        <Setter Property="Height" Value="{StaticResource RowThumbSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource RowThumbRadius}" />
    </Style>
    <Style Selector="Button.queueEntry TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.queueEntry TextBlock.artist">
        <Setter Property="FontSize" Value="{StaticResource QueueRowArtistFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="Button.queueEntry TextBlock.duration">
        <Setter Property="FontSize" Value="{StaticResource QueueRowDurationFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <Style Selector="Button.queueRemove">
        <Setter Property="Width" Value="{StaticResource QueueRemoveSize}" />
        <Setter Property="Height" Value="{StaticResource QueueRemoveSize}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueRemoveRadius}" />
        <Setter Property="Margin" Value="{StaticResource QueueRemoveMargin}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Panel.queueRow:pointerover Button.queueRemove">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.queueRemove:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>
    <Style Selector="Button.queueRemove controls|Icon">
        <Setter Property="Width" Value="{StaticResource QueueRemoveIconSize}" />
        <Setter Property="Height" Value="{StaticResource QueueRemoveIconSize}" />
    </Style>

    <!-- The drop line (mockup: .qline): only while something is dragged over rows. -->
    <Style Selector="Border.dropLine">
        <Setter Property="Height" Value="{StaticResource QueueDropLineHeight}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueDropLineRadius}" />
        <Setter Property="Margin" Value="{StaticResource QueueDropLineMargin}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|QueueDrawerView.over:not(.empty) Border.dropLine">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The empty box (mockup: .qempty), lit while something is dragged over the drawer. -->
    <Style Selector="Panel.queueEmpty">
        <Setter Property="Margin" Value="{StaticResource QueueEmptyMargin}" />
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|QueueDrawerView.empty Panel.queueEmpty">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Panel.queueEmpty > Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource LineBrush}" />
        <Setter Property="StrokeThickness" Value="{StaticResource QueueEmptyDashWidth}" />
        <Setter Property="StrokeDashArray" Value="4,3" />
        <Setter Property="RadiusX" Value="{StaticResource QueueEmptyRadius}" />
        <Setter Property="RadiusY" Value="{StaticResource QueueEmptyRadius}" />
    </Style>
    <Style Selector="Panel.queueEmpty > TextBlock">
        <Setter Property="Margin" Value="{StaticResource QueueEmptyTextMargin}" />
        <Setter Property="FontSize" Value="{StaticResource QueueEmptyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource QueueEmptyLineHeight}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="views|QueueDrawerView.over Panel.queueEmpty > Rectangle">
        <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Fill" Value="{DynamicResource AccentWashBrush}" />
    </Style>
    <Style Selector="views|QueueDrawerView.over Panel.queueEmpty > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
    </Style>

    <!-- The radio station's next picks (mockup: .qradio, .qi.pick). -->
    <Style Selector="StackPanel.queueRadio">
        <Setter Property="Margin" Value="{StaticResource QueueRadioMargin}" />
    </Style>
    <Style Selector="Border.queueRadioHeader">
        <Setter Property="Padding" Value="{StaticResource QueueRadioHeaderPadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineTop}" />
        <Setter Property="TextElement.FontSize" Value="{StaticResource QueueRadioFontSize}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="Border.queueRadioHeader > Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource QueueRadioHeaderGap}" />
    </Style>
    <Style Selector="Border.queueRadioHeader > Grid > controls|Icon">
        <Setter Property="Width" Value="{StaticResource QueueRadioIconSize}" />
        <Setter Property="Height" Value="{StaticResource QueueRadioIconSize}" />
        <Setter Property="IsStroked" Value="True" />
        <Setter Property="StrokeThickness" Value="{StaticResource QueueRadioIconStroke}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.queueRadioHeader > Grid > TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.queueRow.pick">
        <Setter Property="Opacity" Value="{StaticResource QueuePickOpacity}" />
    </Style>
    <Style Selector="Panel.queueRow.pick:pointerover">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- The footer (mockup: .qfoot): ▶ Play and Save as playlist, or the name field with Save and Cancel. -->
    <Style Selector="Border.queueFooter">
        <Setter Property="Padding" Value="{StaticResource QueueFooterPadding}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineTop}" />
    </Style>
    <Style Selector="views|QueueDrawerView.empty Border.queueFooter">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.queueActions">
        <Setter Property="ColumnSpacing" Value="{StaticResource QueueFooterGap}" />
    </Style>
    <Style Selector="Grid.queueActions > Button#SaveQueue">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid.saveForm">
        <Setter Property="ColumnSpacing" Value="{StaticResource QueueFormGap}" />
    </Style>
    <Style Selector="Grid.saveForm > Button">
        <Setter Property="Padding" Value="{StaticResource QueueFormButtonPadding}" />
    </Style>
    <Style Selector="TextBox.playlistName">
        <Setter Property="Theme" Value="{StaticResource TypedBox}" />
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource QueueNameRadius}" />
        <Setter Property="Padding" Value="{StaticResource QueueNamePadding}" />
        <Setter Property="FontSize" Value="{StaticResource QueueNameFontSize}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.playlistName:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
</Styles>
