<!--
  The title bar (mockup: .titlebar, #135): the title, the app menu and its lists, the search box, and room for the system
  window buttons. On macOS (Window.mac) the system buttons sit on the left, so the title moves right and no room is kept
  on the right; the menu is in the menu bar there.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MusicSpin.App.Controls">
    <Style Selector="Border.titleBar">
        <Setter Property="Background" Value="{DynamicResource BgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource HairlineBottom}" />
        <Setter Property="Padding" Value="{StaticResource TitleBarPadding}" />
    </Style>
    <Style Selector="Window.mac Border.titleBar">
        <Setter Property="Padding" Value="{StaticResource MacTitleBarPadding}" />
    </Style>
    <Style Selector="Border.titleBar > Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource TitleBarGap}" />
    </Style>
    <Style Selector="Panel.captionButtons">
        <Setter Property="Width" Value="{StaticResource CaptionButtonsWidth}" />
    </Style>
    <Style Selector="Window.mac Panel.captionButtons">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="StackPanel.brand">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource BrandGap}" />
        <Setter Property="Width" Value="{StaticResource BrandWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The little record: a dark disc, a black ring, the accent label. -->
    <Style Selector="Panel.brandDisc">
        <Setter Property="Width" Value="{StaticResource BrandDiscSize}" />
        <Setter Property="Height" Value="{StaticResource BrandDiscSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.brandDisc > Ellipse">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Ellipse.brandRecord">
        <Setter Property="Width" Value="{StaticResource BrandDiscSize}" />
        <Setter Property="Height" Value="{StaticResource BrandDiscSize}" />
        <Setter Property="Fill" Value="{StaticResource BrandDiscGrooveBrush}" />
    </Style>
    <Style Selector="Ellipse.brandRing">
        <Setter Property="Width" Value="{StaticResource BrandLabelSize}" />
        <Setter Property="Height" Value="{StaticResource BrandLabelSize}" />
        <Setter Property="Fill" Value="{StaticResource BrandDiscBrush}" />
    </Style>
    <Style Selector="Ellipse.brandLabel">
        <Setter Property="Width" Value="{StaticResource BrandLabelInnerSize}" />
        <Setter Property="Height" Value="{StaticResource BrandLabelInnerSize}" />
        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.brandName">
        <Setter Property="FontSize" Value="{StaticResource BrandFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource BrandFontWeight}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- The app menu after the title (#135); its lists are the menu control themes in Controls.axaml. -->
    <Style Selector="NativeMenuBar.appMenu">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NativeMenuBar.appMenu Menu">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource AppMenuBarItem}" />
    </Style>
    <Style Selector="Border.menuPopup">
        <Setter Property="Margin" Value="{StaticResource MenuPopupShadowRoom}" />
        <Setter Property="MinWidth" Value="{StaticResource MenuMinWidth}" />
        <Setter Property="Padding" Value="{StaticResource MenuPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource MenuRadius}" />
        <Setter Property="Background" Value="{DynamicResource Bg3Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
        <Setter Property="BoxShadow" Value="0 8 20 0 #66000000" />
    </Style>
    <Style Selector="TextBlock.menuGesture">
        <Setter Property="Margin" Value="{StaticResource MenuGestureMargin}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.menuTrail">
        <Setter Property="Margin" Value="{StaticResource MenuTrailMargin}" />
        <Setter Property="Width" Value="{StaticResource MenuCheckSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.menuTrail > controls|Icon">
        <Setter Property="Width" Value="{StaticResource MenuCheckSize}" />
        <Setter Property="Height" Value="{StaticResource MenuCheckSize}" />
        <Setter Property="IsStroked" Value="True" />
    </Style>
    <Style Selector="controls|Icon.menuCheck">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="controls|Icon.menuChevron">
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="MenuItem > Separator">
        <Setter Property="Height" Value="{StaticResource MenuSeparatorHeight}" />
        <Setter Property="Margin" Value="{StaticResource MenuSeparatorMargin}" />
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
    </Style>

    <Style Selector="Border.search">
        <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource SearchRadius}" />
        <Setter Property="Padding" Value="{StaticResource SearchPadding}" />
        <Setter Property="Width" Value="{StaticResource SearchWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.search > Grid">
        <Setter Property="ColumnSpacing" Value="{StaticResource SearchGap}" />
    </Style>
    <Style Selector="Border.search controls|Icon">
        <Setter Property="Width" Value="{StaticResource SearchIconSize}" />
        <Setter Property="Height" Value="{StaticResource SearchIconSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Fg2Brush}" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="Theme" Value="{StaticResource SearchBox}" />
        <Setter Property="FontSize" Value="{StaticResource SearchFontSize}" />
    </Style>
</Styles>
