<!--
  Sizes, spacing, radii and font sizes, named by role (docs/design/mockup/styles.css). They don't change with the theme,
  so views may use StaticResource.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- The window grid: title bar, sidebar | content, player bar. -->
    <GridLength x:Key="TitleBarHeight">44</GridLength>
    <sys:Double x:Key="TitleBarHeightValue">44</sys:Double>
    <GridLength x:Key="SidebarWidth">220</GridLength>
    <GridLength x:Key="PlayerBarHeight">84</GridLength>
    <sys:Double x:Key="WindowWidth">1440</sys:Double>
    <sys:Double x:Key="WindowHeight">880</sys:Double>
    <sys:Double x:Key="WindowMinWidth">1280</sys:Double>
    <sys:Double x:Key="WindowMinHeight">720</sys:Double>
    <Thickness x:Key="HairlineBottom">0,0,0,1</Thickness>
    <Thickness x:Key="HairlineRight">0,0,1,0</Thickness>
    <Thickness x:Key="HairlineTop">0,1,0,0</Thickness>
    <Thickness x:Key="HairlineLeft">1,0,0,0</Thickness>
    <Thickness x:Key="Hairline">1</Thickness>

    <!-- Title bar -->
    <Thickness x:Key="TitleBarPadding">16,0,0,0</Thickness>
    <Thickness x:Key="MacTitleBarPadding">78,0,0,0</Thickness>
    <sys:Double x:Key="TitleBarGap">16</sys:Double>
    <sys:Double x:Key="BrandWidth">188</sys:Double>
    <sys:Double x:Key="BrandGap">8</sys:Double>
    <sys:Double x:Key="BrandDiscSize">18</sys:Double>
    <!-- The accent centre of the brand disc: the inner 28% of its radius, plus the dark ring around it. -->
    <sys:Double x:Key="BrandLabelSize">9</sys:Double>
    <sys:Double x:Key="BrandLabelInnerSize">7</sys:Double>
    <sys:Double x:Key="BrandFontSize">14</sys:Double>
    <sys:Double x:Key="SearchMaxWidth">420</sys:Double>
    <Thickness x:Key="SearchPadding">10,5</Thickness>
    <CornerRadius x:Key="SearchRadius">8</CornerRadius>
    <sys:Double x:Key="SearchFontSize">13</sys:Double>
    <sys:Double x:Key="SearchIconSize">14</sys:Double>
    <sys:Double x:Key="SearchGap">8</sys:Double>
    <!-- Room left for the system window buttons: on the right on Windows and Linux; on macOS they are on the left
         (MacTitleBarPadding). -->
    <sys:Double x:Key="CaptionButtonsWidth">138</sys:Double>
    <!-- The system buttons we draw (Windows, Linux; mockup: .winctl i): 3 x 46 = CaptionButtonsWidth. -->
    <sys:Double x:Key="CaptionButtonWidth">46</sys:Double>
    <sys:Double x:Key="CaptionIconSize">10</sys:Double>
    <Thickness x:Key="WindowFrameThickness">1</Thickness>
    <Thickness x:Key="WindowShadowThickness">8</Thickness>

    <!-- Sidebar -->
    <Thickness x:Key="SidebarPadding">10,12</Thickness>
    <sys:Double x:Key="NavFontSize">13.5</sys:Double>
    <sys:Double x:Key="NavHeaderFontSize">11</sys:Double>
    <sys:Double x:Key="NavHeaderLetterSpacing">0.9</sys:Double>
    <Thickness x:Key="NavHeaderMargin">10,14,10,6</Thickness>
    <Thickness x:Key="NavItemPadding">10,7</Thickness>
    <CornerRadius x:Key="NavItemRadius">7</CornerRadius>
    <sys:Double x:Key="NavIconSize">14</sys:Double>
    <sys:Double x:Key="NavIconGap">8</sys:Double>
    <!-- Favorites' track count after its name. -->
    <sys:Double x:Key="NavCountFontSize">12</sys:Double>
    <!-- A playlist's name box while it is renamed: the entry's height (7 + text + 7, less the 1 px border each side). -->
    <Thickness x:Key="NavRenamePadding">9,6</Thickness>

    <!-- Content -->
    <Thickness x:Key="ToolbarPadding">28,18,28,10</Thickness>
    <sys:Double x:Key="ToolbarGap">18</sys:Double>
    <sys:Double x:Key="PageTitleFontSize">22</sys:Double>
    <sys:Double x:Key="PageCountFontSize">13</sys:Double>
    <Thickness x:Key="PageCountMargin">6,0,0,3</Thickness>
    <Thickness x:Key="ViewPadding">28,8,28,40</Thickness>
    <sys:Double x:Key="BodyFontSize">13.5</sys:Double>
    <sys:Double x:Key="SmallFontSize">12.5</sys:Double>
    <sys:Double x:Key="EmptyFontSize">14</sys:Double>
    <Thickness x:Key="EmptyMargin">0,40</Thickness>
    <sys:Double x:Key="EmptyHintGap">6</sys:Double>
    <sys:Double x:Key="EmptyHeartSize">14</sys:Double>
    <sys:Double x:Key="EmptyHintWordGap">4</sys:Double>
    <!-- Favorites' line under the title (favorites no longer in the library), lined up with the title. -->
    <Thickness x:Key="PageNoteMargin">28,0,28,10</Thickness>
    <sys:Double x:Key="PageNoteGap">6</sys:Double>
    <sys:Double x:Key="PageNoteFontSize">12.5</sys:Double>
    <Thickness x:Key="BannerPadding">28,8</Thickness>
    <sys:Double x:Key="BannerGap">12</sys:Double>
    <CornerRadius x:Key="ButtonRadius">7</CornerRadius>
    <Thickness x:Key="ButtonPadding">12,6</Thickness>
    <sys:Double x:Key="ButtonFontSize">13</sys:Double>
    <!-- A playlist's ▶ Play and ＋ Queue (mockup: .btn.ghost, margin-left 6px). -->
    <sys:Double x:Key="PageActionsGap">6</sys:Double>
    <sys:Double x:Key="PageActionIconSize">11</sys:Double>
    <sys:Double x:Key="PageActionIconGap">5</sys:Double>

    <!-- Toolbar controls (mockup: .sort, .dd): the Sort and Group dropdowns. -->
    <sys:Double x:Key="DropdownGap">4</sys:Double>
    <Thickness x:Key="DropdownPadding">8,4</Thickness>
    <CornerRadius x:Key="DropdownRadius">6</CornerRadius>
    <sys:Double x:Key="DropdownFontSize">12.5</sys:Double>
    <sys:Double x:Key="DropdownChevronSize">8</sys:Double>
    <Thickness x:Key="DropdownChevronMargin">5,1,0,0</Thickness>

    <!-- The menu (mockup: .menu): under the button that opened it, 8 px inside the window at least. -->
    <sys:Double x:Key="MenuMinWidth">170</sys:Double>
    <Thickness x:Key="MenuPadding">5</Thickness>
    <CornerRadius x:Key="MenuRadius">9</CornerRadius>
    <Thickness x:Key="MenuEntryPadding">10,7</Thickness>
    <CornerRadius x:Key="MenuEntryRadius">6</CornerRadius>
    <sys:Double x:Key="MenuFontSize">13</sys:Double>
    <sys:Double x:Key="MenuCheckSize">12</sys:Double>
    <sys:Double x:Key="MenuAnchorGap">4</sys:Double>
    <sys:Double x:Key="MenuWindowMargin">8</sys:Double>
    <Thickness x:Key="MenuChevronMargin">12,0,0,0</Thickness>
    <!-- A confirmation's question (the mockup has none): an entry's inset, in the small type. -->
    <sys:Double x:Key="MenuCaptionMaxWidth">220</sys:Double>
    <Thickness x:Key="MenuCaptionMargin">10,6,10,6</Thickness>
    <sys:Double x:Key="MenuCaptionFontSize">12.5</sys:Double>

    <!-- Group headers (mockup: .group-h, .group + .group); tall enough for the Play and Radio pills (#41, #23). -->
    <sys:Double x:Key="GroupHeaderFontSize">13</sys:Double>
    <sys:Double x:Key="GroupHeaderLetterSpacing">1.04</sys:Double>
    <sys:Double x:Key="GroupHeaderMinHeight">24</sys:Double>
    <Thickness x:Key="GroupHeaderMargin">0,30,0,12</Thickness>
    <Thickness x:Key="FirstGroupHeaderMargin">0,0,0,12</Thickness>
    <sys:Double x:Key="GroupHeaderGap">12</sys:Double>

    <!--
      Radio (#41, #23, #24). A group's Play and Radio pills (mockup: .group-acts, .radio-btn, .group-play): 6 apart,
      padded 3 10 3 8, in 11.5 type, with a 15 icon 5 from the label. The mockup's icons are lines 2 wide in a 24 box,
      so 1.25 at 15. On a grouped crate's label they are icons only, laid out at the crate's full size (÷ .62): padded 6,
      2 apart, 8 in from the box's end. The waves fade to 25% as they pulse (@keyframes onair).
    -->
    <sys:Double x:Key="GroupActsGap">6</sys:Double>
    <Thickness x:Key="GroupActPadding">8,3,10,3</Thickness>
    <CornerRadius x:Key="GroupActRadius">999</CornerRadius>
    <sys:Double x:Key="GroupActFontSize">11.5</sys:Double>
    <sys:Double x:Key="GroupActIconSize">15</sys:Double>
    <sys:Double x:Key="GroupActIconGap">5</sys:Double>
    <sys:Double x:Key="RadioIconStroke">1.25</sys:Double>
    <Rect x:Key="RadioViewBox">0,0,24,24</Rect>
    <Rect x:Key="GroupPlayViewBox">0,0,24,24</Rect>
    <sys:Double x:Key="OnAirWaveDimOpacity">0.25</sys:Double>
    <Thickness x:Key="CrateActPadding">9.7</Thickness>
    <sys:Double x:Key="CrateActIconSize">24.2</sys:Double>
    <sys:Double x:Key="CrateActStroke">2</sys:Double>
    <sys:Double x:Key="CrateActsGap">3.2</sys:Double>
    <Thickness x:Key="CrateActsMargin">0,0,12.9,0</Thickness>
    <!-- The player bar's RADIO pill (mockup: .onair): 8 before the title, padded 1 7 1 5, 10 bold capitals 0.06em apart, a 12 icon 4 from them. -->
    <Thickness x:Key="OnAirPillMargin">0,0,8,0</Thickness>
    <Thickness x:Key="OnAirPillPadding">5,1,7,1</Thickness>
    <CornerRadius x:Key="OnAirPillRadius">999</CornerRadius>
    <sys:Double x:Key="OnAirPillFontSize">10</sys:Double>
    <sys:Double x:Key="OnAirPillLetterSpacing">0.6</sys:Double>
    <sys:Double x:Key="OnAirPillIconSize">12</sys:Double>
    <sys:Double x:Key="OnAirPillIconGap">4</sys:Double>
    <!--
      The Radio page (mockup: .radio): the tags, then 36 apart the 330 station card, below the view's top padding plus 6.
      The hint 14 above the rows (13 type); a row (.facet) 13 above and below its top line, its 92 title 14 from its
      tags, 7 down (11 capitals 0.08em apart). Tags (.tag) 7 apart, padded 5 11, 13 type, the count 11, 6 apart; a
      left-out tag's dashes. The note after a row's tags 4 along, in 12.5.
    -->
    <Thickness x:Key="RadioTagsPadding">28,14,36,40</Thickness>
    <Thickness x:Key="StationMargin">0,14,28,40</Thickness>
    <sys:Double x:Key="StationWidth">330</sys:Double>
    <Thickness x:Key="RadioHintMargin">0,0,0,14</Thickness>
    <sys:Double x:Key="RadioHintFontSize">13</sys:Double>
    <Thickness x:Key="FacetPadding">0,13</Thickness>
    <sys:Double x:Key="FacetTitleWidth">92</sys:Double>
    <sys:Double x:Key="FacetGap">14</sys:Double>
    <Thickness x:Key="FacetTitleMargin">0,7,0,0</Thickness>
    <sys:Double x:Key="FacetTitleFontSize">11</sys:Double>
    <sys:Double x:Key="FacetTitleLetterSpacing">0.88</sys:Double>
    <sys:Double x:Key="TagGap">7</sys:Double>
    <Thickness x:Key="TagPadding">11,5</Thickness>
    <CornerRadius x:Key="TagRadius">999</CornerRadius>
    <sys:Double x:Key="TagDashRadius">14</sys:Double>
    <sys:Double x:Key="TagDashThickness">1</sys:Double>
    <sys:Double x:Key="TagFontSize">13</sys:Double>
    <sys:Double x:Key="TagCountFontSize">11</sys:Double>
    <sys:Double x:Key="TagTextGap">6</sys:Double>
    <Thickness x:Key="TagNoteMargin">4,0,0,0</Thickness>
    <sys:Double x:Key="TagNoteFontSize">12.5</sys:Double>
    <!--
      The station card (mockup: .station): padded 18 20 20, radius 14; the kicker (11 capitals 0.1em apart, a 15 icon 7
      before), the description 10 below in 20 type (1.35 high), the size 6 below that in 13, the buttons 16 below and 6
      apart, Clear tags padded 6 4 in 12.5; the next picks 18 below over a line, 12 under it, 8 apart, a 32 cover 10 from
      the title (13) and the artist (11.5).
    -->
    <Thickness x:Key="StationPadding">20,18,20,20</Thickness>
    <CornerRadius x:Key="StationRadius">14</CornerRadius>
    <sys:Double x:Key="StationKickerGap">7</sys:Double>
    <sys:Double x:Key="StationKickerFontSize">11</sys:Double>
    <sys:Double x:Key="StationKickerLetterSpacing">1.1</sys:Double>
    <sys:Double x:Key="StationIconSize">15</sys:Double>
    <Thickness x:Key="StationTitleMargin">0,10,0,6</Thickness>
    <sys:Double x:Key="StationTitleFontSize">20</sys:Double>
    <sys:Double x:Key="StationTitleLineHeight">27</sys:Double>
    <Thickness x:Key="StationMetaMargin">0,0,0,16</Thickness>
    <sys:Double x:Key="StationMetaFontSize">13</sys:Double>
    <sys:Double x:Key="StationActsGap">6</sys:Double>
    <Thickness x:Key="LinkPadding">4,6</Thickness>
    <sys:Double x:Key="LinkFontSize">12.5</sys:Double>
    <Thickness x:Key="StationNextMargin">0,18,0,0</Thickness>
    <Thickness x:Key="StationNextPadding">0,12,0,0</Thickness>
    <sys:Double x:Key="StationNextGap">8</sys:Double>
    <Thickness x:Key="StationNextTitleMargin">0,0,0,2</Thickness>
    <sys:Double x:Key="StationPickCoverSize">32</sys:Double>
    <sys:Double x:Key="StationPickGap">10</sys:Double>
    <sys:Double x:Key="StationPickFontSize">13</sys:Double>
    <sys:Double x:Key="StationPickArtistFontSize">11.5</sys:Double>

    <!--
      Album cards (mockup: .grid, .card): columns at least 176 wide, 26 apart; rows 30 apart. The art is laid out at
      200 x 200 and scaled to the card's width, so the record's 3% inset and the moves in % stay in proportion.
    -->
    <sys:Double x:Key="CardMinWidth">176</sys:Double>
    <sys:Double x:Key="CardColumnGap">26</sys:Double>
    <Thickness x:Key="CardRowGapMargin">0,30,0,0</Thickness>
    <sys:Double x:Key="CardArtSize">200</sys:Double>
    <sys:Double x:Key="CardVinylSize">188</sys:Double>
    <Thickness x:Key="CardVinylMargin">6</Thickness>
    <sys:Double x:Key="PlayFabSize">40</sys:Double>
    <CornerRadius x:Key="PlayFabRadius">20</CornerRadius>
    <Thickness x:Key="PlayFabMargin">8</Thickness>
    <sys:Double x:Key="PlayFabIconSize">14</sys:Double>
    <sys:Double x:Key="CardTitleFontSize">14</sys:Double>
    <Thickness x:Key="CardTitleMargin">0,10,0,0</Thickness>
    <Thickness x:Key="CardDetailsMargin">0,2,0,0</Thickness>
    <sys:Double x:Key="CardDetailsGap">6</sys:Double>

    <!--
      The shelf (mockup: .shelf, .shelf-row, .slot, .board): sleeves 170 square on rows 214 high, padded 24 left and 30
      right; a 16 high board under each row, the next row 10 below it, and 34 after a group's last board. The shelf's
      group headers sit right on the first row. The sleeve's thickness (its spine) is 6; its contact shadow 14 high.
    -->
    <sys:Double x:Key="ShelfSleeveSize">170</sys:Double>
    <CornerRadius x:Key="ShelfCoverRadius">2</CornerRadius>
    <!-- The record in a sleeve, inset 4% on each side (mockup: .sleeve3d .vinyl, inset 4%). -->
    <sys:Double x:Key="ShelfRecordSize">156.4</sys:Double>
    <sys:Double x:Key="ShelfRowHeight">214</sys:Double>
    <Thickness x:Key="ShelfRowPadding">24,10,30,0</Thickness>
    <sys:Double x:Key="ShelfBoardHeight">16</sys:Double>
    <CornerRadius x:Key="ShelfBoardRadius">3</CornerRadius>
    <Thickness x:Key="ShelfBoardGapMargin">0,10,0,0</Thickness>
    <Thickness x:Key="ShelfGroupGapMargin">0,0,0,34</Thickness>
    <Thickness x:Key="ShelfGroupHeaderMargin">0</Thickness>
    <sys:Double x:Key="ShelfSpineWidth">6</sys:Double>
    <sys:Double x:Key="ShelfShadowHeight">14</sys:Double>
    <!-- The spine is in shadow (mockup: .edge filter: brightness(.55)). -->
    <sys:Double x:Key="ShelfSpineShade">0.55</sys:Double>
    <!--
      An invisible frame around a sleeve, past anything it draws (facing you at the deepest setting it reaches 9 above
      its slot): its image at rest then starts on a whole pixel, as the sleeve does, so it looks the same as drawn live.
    -->
    <Thickness x:Key="ShelfCacheFrame">-16</Thickness>

    <!--
      The crate (mockup: .crate-wrap, .crate, .crate-stage, .crate-box, .crate-side). One crate is laid out at full
      size: records 300 square standing 70 above the crate's bottom, in a box 380 x 100 that is 40 above it; it fills
      the view, at least 470 high. Grouped, each crate is that same layout (CrateGroupedWidth x CrateGroupedHeight)
      scaled by .62 into a cell at least 250 wide and 279 high (450 x .62); its label's 11 px and the 72 px left for
      the group's icons are divided by .62 to stay that size. The side panel is 280 wide, 30 from the crates.
    -->
    <sys:Double x:Key="CrateRecordSize">300</sys:Double>
    <!-- The widest a crate shows a record's cover: the front one leaning out at you (Views/Pages/AlbumsPage.axaml.cs decodes covers for it). -->
    <sys:Double x:Key="CrateCoverMost">330</sys:Double>
    <Thickness x:Key="CrateRecordMargin">0,0,0,70</Thickness>
    <sys:Double x:Key="CrateBoxWidth">380</sys:Double>
    <sys:Double x:Key="CrateBoxHeight">100</sys:Double>
    <Thickness x:Key="CrateBoxMargin">0,0,0,40</Thickness>
    <CornerRadius x:Key="CrateBoxRadius">6</CornerRadius>
    <sys:Double x:Key="CrateMinHeight">470</sys:Double>
    <sys:Double x:Key="CrateLabelFontSize">11</sys:Double>
    <sys:Double x:Key="CrateLabelLetterSpacing">4.4</sys:Double>
    <sys:Double x:Key="CrateGroupedWidth">404</sys:Double>
    <sys:Double x:Key="CrateGroupedHeight">450</sys:Double>
    <sys:Double x:Key="CrateCellMinWidth">250</sys:Double>
    <sys:Double x:Key="CrateCellHeight">279</sys:Double>
    <sys:Double x:Key="CrateCellColumnGap">12</sys:Double>
    <sys:Double x:Key="CrateCellRowGap">4</sys:Double>
    <sys:Double x:Key="CrateGroupLabelFontSize">17.7</sys:Double>
    <sys:Double x:Key="CrateGroupLabelLetterSpacing">2.1</sys:Double>
    <Thickness x:Key="CrateGroupLabelPadding">24,0,116,0</Thickness>
    <sys:Double x:Key="CrateSideWidth">280</sys:Double>
    <sys:Double x:Key="CrateSideGap">30</sys:Double>
    <Thickness x:Key="CrateSideMargin">0,8,28,40</Thickness>
    <Thickness x:Key="CrateSideGroupedMargin">0,48,28,40</Thickness>
    <!-- The crates take the view's padding (ViewPadding) on their side; the side panel on its own. -->
    <Thickness x:Key="SoleCrateMargin">28,8,0,40</Thickness>
    <Thickness x:Key="CrateScrollPadding">28,8,0,40</Thickness>
    <CornerRadius x:Key="CrateCoverRadius">3</CornerRadius>
    <!-- A record's hover light (mockup: .crate .rec:hover::after, opacity .07). -->
    <sys:Double x:Key="CrateRecordHoverOpacity">0.07</sys:Double>
    <sys:Double x:Key="CrateTitleFontSize">26</sys:Double>
    <Thickness x:Key="CrateTitleMargin">0,0,0,4</Thickness>
    <Thickness x:Key="CrateArtistMargin">0,0,0,16</Thickness>
    <Thickness x:Key="CrateChipsMargin">0,0,0,18</Thickness>
    <sys:Double x:Key="CrateButtonsGap">6</sys:Double>

    <!-- The kicker above a title (mockup: .np-kicker) and the format chips (.np-tech span). -->
    <sys:Double x:Key="KickerFontSize">11</sys:Double>
    <sys:Double x:Key="KickerLetterSpacing">1.1</sys:Double>
    <sys:Double x:Key="ChipGap">8</sys:Double>
    <sys:Double x:Key="ChipFontSize">11.5</sys:Double>
    <Thickness x:Key="ChipPadding">8,3</Thickness>
    <CornerRadius x:Key="ChipRadius">999</CornerRadius>
    <Thickness x:Key="ChipBorderThickness">1</Thickness>
    <!-- A big round-ended button (mockup: .btn, padding 9px 18px, radius 999px). -->
    <Thickness x:Key="PillButtonPadding">18,9</Thickness>
    <CornerRadius x:Key="PillButtonRadius">999</CornerRadius>
    <sys:Double x:Key="PillButtonFontSize">14</sys:Double>
    <sys:Double x:Key="PillIconSize">12</sys:Double>
    <sys:Double x:Key="PillIconGap">6</sys:Double>

    <!-- Track rows (mockup: .tlist, .tr) and album headers (.talbum). -->
    <Thickness x:Key="RowPadding">10,5</Thickness>
    <CornerRadius x:Key="RowRadius">7</CornerRadius>
    <sys:Double x:Key="RowGap">14</sys:Double>
    <Thickness x:Key="RowListGapMargin">0,0,0,1</Thickness>
    <sys:Double x:Key="RowThumbSize">36</sys:Double>
    <CornerRadius x:Key="RowThumbRadius">3</CornerRadius>
    <sys:Double x:Key="RowPlayIconSize">10</sys:Double>
    <sys:Double x:Key="RowNoteSize">13</sys:Double>
    <GridLength x:Key="RowThumbColumn">36</GridLength>
    <GridLength x:Key="RowNumberColumn">26</GridLength>
    <GridLength x:Key="RowDurationColumn">44</GridLength>
    <GridLength x:Key="RowAddColumn">28</GridLength>
    <sys:Double x:Key="RowSecondaryFontSize">12</sys:Double>
    <!-- A playlist entry whose file is missing (the mockup has none; as dim as a muted control). -->
    <sys:Double x:Key="UnavailableOpacity">0.45</sys:Double>
    <sys:Double x:Key="AddButtonSize">28</sys:Double>
    <CornerRadius x:Key="AddButtonRadius">14</CornerRadius>
    <sys:Double x:Key="AddIconSize">13</sys:Double>
    <!-- The heart (#48): a column of its own in track rows, before the duration. -->
    <GridLength x:Key="RowHeartColumn">28</GridLength>
    <sys:Double x:Key="HeartButtonSize">28</sys:Double>
    <sys:Double x:Key="HeartIconSize">14</sys:Double>
    <Thickness x:Key="AlbumHeadPadding">10,8</Thickness>
    <Thickness x:Key="AlbumHeadMargin">0,30,0,4</Thickness>
    <Thickness x:Key="FirstAlbumHeadMargin">0,0,0,4</Thickness>
    <sys:Double x:Key="AlbumHeadGap">14</sys:Double>
    <sys:Double x:Key="AlbumHeadCoverSize">56</sys:Double>
    <sys:Double x:Key="AlbumHeadTitleFontSize">16</sys:Double>
    <Thickness x:Key="AlbumHeadDetailsMargin">0,2,0,0</Thickness>
    <sys:Double x:Key="AlbumHeadActionsGap">4</sys:Double>
    <sys:Double x:Key="IconButtonSize">32</sys:Double>
    <CornerRadius x:Key="IconButtonRadius">16</CornerRadius>
    <sys:Double x:Key="IconButtonIconSize">12</sys:Double>

    <!-- Player bar -->
    <Thickness x:Key="PlayerBarPadding">18,0</Thickness>
    <sys:Double x:Key="PlayerBarGap">16</sys:Double>
    <sys:Double x:Key="MiniWidth">84</sys:Double>
    <sys:Double x:Key="MiniHeight">58</sys:Double>
    <sys:Double x:Key="MiniCoverSize">58</sys:Double>
    <sys:Double x:Key="MiniVinylSize">52</sys:Double>
    <Thickness x:Key="MiniVinylMargin">4,3,0,0</Thickness>
    <sys:Double x:Key="PlayerTitleFontSize">14</sys:Double>
    <sys:Double x:Key="PlayerArtistFontSize">12.5</sys:Double>
    <!-- The heart after the title: its button overhangs the title's line, so the line keeps its height. -->
    <sys:Double x:Key="PlayerHeartSize">20</sys:Double>
    <Thickness x:Key="PlayerHeartMargin">4,-3,0,-3</Thickness>
    <Thickness x:Key="NowPlayingHeartMargin">0,-3</Thickness>
    <sys:Double x:Key="PlayerHeartIconSize">13</sys:Double>
    <sys:Double x:Key="TransportGap">14</sys:Double>
    <sys:Double x:Key="TransportIconSize">13</sys:Double>
    <sys:Double x:Key="PlayButtonSize">38</sys:Double>
    <sys:Double x:Key="PlayIconSize">12</sys:Double>
    <CornerRadius x:Key="PlayButtonRadius">19</CornerRadius>
    <sys:Double x:Key="BannerIconSize">12</sys:Double>
    <!-- The song name, then the analyzer and the volume at this gap (mockup: .meta). -->
    <sys:Double x:Key="PlayerMetaGap">24</sys:Double>
    <!-- Shuffle and Repeat (stroked), and Repeat one's small "1". -->
    <sys:Double x:Key="ModeIconSize">15</sys:Double>
    <sys:Double x:Key="RepeatOneFontSize">8</sys:Double>
    <Thickness x:Key="RepeatOneMargin">0,0,-5,-4</Thickness>
    <sys:Double x:Key="TransportDisabledOpacity">0.3</sys:Double>
    <!-- The buttons above the position (mockup: .transport, gap 6). -->
    <sys:Double x:Key="TransportRowGap">6</sys:Double>
    <sys:Double x:Key="ProgressMaxWidth">560</sys:Double>
    <sys:Double x:Key="ProgressGap">8</sys:Double>
    <sys:Double x:Key="ProgressFontSize">11.5</sys:Double>
    <!-- The elapsed time box (mockup: .tnum) and the duration after the bar. -->
    <sys:Double x:Key="TimeBoxWidth">46</sys:Double>
    <Thickness x:Key="TimeBoxPadding">4,2</Thickness>
    <CornerRadius x:Key="TimeBoxRadius">5</CornerRadius>
    <Thickness x:Key="DurationPadding">5,0,0,0</Thickness>
    <!-- The right-hand side: the format, then the queue and settings buttons (mockup: .right, .tech, .badge, .qbtn). -->
    <sys:Double x:Key="PlayerRightGap">18</sys:Double>
    <sys:Double x:Key="PlayerRightFontSize">12</sys:Double>
    <sys:Double x:Key="TechGap">8</sys:Double>
    <Thickness x:Key="BadgePadding">7,2</Thickness>
    <CornerRadius x:Key="BadgeRadius">4</CornerRadius>
    <sys:Double x:Key="HiResFontSize">9.5</sys:Double>
    <Thickness x:Key="HiResPadding">4,1</Thickness>
    <CornerRadius x:Key="HiResRadius">3</CornerRadius>
    <sys:Double x:Key="HiResLetterSpacing">0.4</sys:Double>
    <sys:Double x:Key="PlayerButtonsGap">6</sys:Double>
    <sys:Double x:Key="RoundButtonSize">30</sys:Double>
    <CornerRadius x:Key="RoundButtonRadius">15</CornerRadius>
    <sys:Double x:Key="QueueIconSize">14</sys:Double>
    <sys:Double x:Key="CogIconSize">18</sys:Double>
    <sys:Double x:Key="CogStrokeThickness">1.6</sys:Double>
    <sys:Double x:Key="CountBadgeSize">17</sys:Double>
    <Thickness x:Key="CountBadgePadding">4,0</Thickness>
    <CornerRadius x:Key="CountBadgeRadius">9</CornerRadius>
    <sys:Double x:Key="CountBadgeFontSize">10</sys:Double>
    <Thickness x:Key="CountBadgeMargin">0,-4,-6,0</Thickness>

    <!-- Bars you drag (mockup: .bar, .vbar): a 4 px line in a 20 px hit area, a 14 px handle. -->
    <sys:Double x:Key="ScrubBarHeight">20</sys:Double>
    <sys:Double x:Key="ScrubLineHeight">4</sys:Double>
    <CornerRadius x:Key="ScrubLineRadius">2</CornerRadius>
    <sys:Double x:Key="ScrubHandleSize">14</sys:Double>
    <CornerRadius x:Key="ScrubHandleRadius">7</CornerRadius>
    <!-- Centred on the end of the fill: half the handle left, (20 - 14) / 2 down. -->
    <Thickness x:Key="ScrubHandleMargin">-7,3,0,0</Thickness>
    <!-- The keyboard focus outline: 2 px, 4 px outside the bar. -->
    <Thickness x:Key="FocusRingThickness">2</Thickness>
    <Thickness x:Key="FocusRingMargin">-4</Thickness>
    <CornerRadius x:Key="FocusRingRadius">3</CornerRadius>
    <!-- The position bar: its first pixels are exactly 0:00; the tip over the pointer. -->
    <sys:Double x:Key="PositionSnapWidth">6</sys:Double>
    <sys:Double x:Key="PositionTipBottom">20</sys:Double>
    <Thickness x:Key="PositionTipPadding">6,1</Thickness>
    <CornerRadius x:Key="PositionTipRadius">5</CornerRadius>
    <sys:Double x:Key="PositionTipFontSize">11</sys:Double>

    <!-- The volume (mockup: .vol, .vbar, .vnum). -->
    <sys:Double x:Key="VolumeGap">8</sys:Double>
    <sys:Double x:Key="SpeakerIconSize">21</sys:Double>
    <sys:Double x:Key="SpeakerStrokeThickness">1.7</sys:Double>
    <sys:Double x:Key="VolumeBarWidth">90</sys:Double>
    <sys:Double x:Key="VolumeBoxWidth">46</sys:Double>
    <Thickness x:Key="VolumeBoxMargin">2,0,0,0</Thickness>
    <Thickness x:Key="VolumeBoxPadding">5,3</Thickness>
    <CornerRadius x:Key="VolumeBoxRadius">6</CornerRadius>
    <sys:Double x:Key="VolumeFontSize">12.5</sys:Double>
    <sys:Double x:Key="MutedOpacity">0.45</sys:Double>
    <sys:Double x:Key="MutedFillOpacity">0.35</sys:Double>

    <!-- The spectrum analyzer: 16 bars x 16 rows, 4 px bars 1 px apart (79 x 32), fading to 0.4 at the bottom. -->
    <sys:Double x:Key="AnalyzerWidth">79</sys:Double>
    <sys:Double x:Key="AnalyzerHeight">32</sys:Double>
    <sys:Double x:Key="AnalyzerBarWidth">4</sys:Double>
    <sys:Double x:Key="AnalyzerBarGap">1</sys:Double>
    <sys:Double x:Key="AnalyzerBottomOpacity">0.4</sys:Double>

    <!-- Covers and records -->
    <CornerRadius x:Key="CoverRadius">4</CornerRadius>
    <sys:Double x:Key="CoverShadowBlur">24</sys:Double>
    <sys:Double x:Key="CoverShadowOffsetY">10</sys:Double>
    <!-- Placeholder title as a share of the cover's width (the mockup's 9cqw), and its smallest size. -->
    <sys:Double x:Key="PlaceholderTitleScale">0.09</sys:Double>
    <sys:Double x:Key="PlaceholderMinFontSize">6</sys:Double>
    <sys:Double x:Key="PlaceholderMaxFontSize">15</sys:Double>
    <!-- The record: label = inner 35%, hole = 3.2%, grooves every 2.4 px. -->
    <sys:Double x:Key="VinylLabelScale">0.35</sys:Double>
    <sys:Double x:Key="VinylHoleScale">0.032</sys:Double>
    <sys:Double x:Key="VinylGroovePitch">2.4</sys:Double>

    <!-- Dialogs (mockup: .dlg, .dlg header, .qclose): 440 wide, 40 px from the window's top and bottom at most. -->
    <sys:Double x:Key="DialogWidth">440</sys:Double>
    <Thickness x:Key="DialogMargin">0,40</Thickness>
    <Thickness x:Key="DialogPadding">22,8,22,22</Thickness>
    <CornerRadius x:Key="DialogRadius">14</CornerRadius>
    <Thickness x:Key="DialogBorderThickness">1</Thickness>
    <Thickness x:Key="DialogHeaderMargin">0,0,-8,4</Thickness>
    <Thickness x:Key="DialogTitleMargin">0,10</Thickness>
    <sys:Double x:Key="DialogTitleFontSize">18</sys:Double>
    <sys:Double x:Key="DialogCloseSize">28</sys:Double>
    <CornerRadius x:Key="DialogCloseRadius">14</CornerRadius>
    <sys:Double x:Key="DialogCloseIconSize">14</sys:Double>
    <!-- The dialog rising in (mockup: @keyframes dlg-in: from 8 px lower, at 98%). -->
    <sys:Double x:Key="DialogInOffset">8</sys:Double>

    <!-- Settings (mockup: .dlg h3, .set-row, .seg, .range, output). -->
    <Thickness x:Key="SettingsSectionMargin">0,18,0,4</Thickness>
    <sys:Double x:Key="SettingsSectionFontSize">11</sys:Double>
    <sys:Double x:Key="SettingsSectionLetterSpacing">0.9</sys:Double>
    <sys:Double x:Key="SettingRowMinHeight">44</sys:Double>
    <sys:Double x:Key="SettingRowGap">16</sys:Double>
    <Thickness x:Key="SettingRowDivider">0,1,0,0</Thickness>
    <Thickness x:Key="SettingRowTallPadding">0,10</Thickness>
    <sys:Double x:Key="SettingNoteFontSize">11.5</sys:Double>
    <Thickness x:Key="SettingNoteMargin">0,1,0,0</Thickness>
    <!--
      Settings › Library and Audio (#31, #32; not in the mockup, so in the dialog's own look): a small button padded 12 6;
      the folder rows padded 8 above and below; what the last scan couldn't read, 10 below the rows, each 6 apart. A switch
      36 x 20, its knob 16, 2 in from the track's edge.
    -->
    <Thickness x:Key="SettingButtonPadding">12,6</Thickness>
    <!-- The empty library's Add a music folder: 16 under the message, the scan's progress 12 under it. -->
    <Thickness x:Key="AddMusicMargin">0,16,0,0</Thickness>
    <sys:Double x:Key="AddMusicGap">12</sys:Double>
    <Thickness x:Key="FolderRowPadding">0,8</Thickness>
    <sys:Double x:Key="SettingDropdownMaxWidth">240</sys:Double>
    <Thickness x:Key="ScanIssuesMargin">0,10,0,0</Thickness>
    <sys:Double x:Key="ScanIssuesGap">6</sys:Double>
    <sys:Double x:Key="SwitchWidth">36</sys:Double>
    <sys:Double x:Key="SwitchHeight">20</sys:Double>
    <CornerRadius x:Key="SwitchRadius">10</CornerRadius>
    <sys:Double x:Key="SwitchKnobSize">16</sys:Double>
    <Thickness x:Key="SwitchKnobMargin">2</Thickness>
    <sys:Double x:Key="SettingSliderWidth">170</sys:Double>
    <sys:Double x:Key="SettingSliderGap">10</sys:Double>
    <sys:Double x:Key="SettingOutputWidth">30</sys:Double>
    <Thickness x:Key="SegmentedBorderThickness">1</Thickness>
    <Thickness x:Key="SegmentedPadding">3</Thickness>
    <CornerRadius x:Key="SegmentedRadius">9</CornerRadius>
    <!-- 12,5 in the mockup, less the 1 px border that shows keyboard focus. -->
    <Thickness x:Key="SegmentPadding">11,4</Thickness>
    <Thickness x:Key="SegmentBorderThickness">1</Thickness>
    <CornerRadius x:Key="SegmentRadius">6</CornerRadius>
    <sys:Double x:Key="SegmentFontSize">13</sys:Double>
    <!-- Settings › Turntable › Design: a card per design, its preview over its name. -->
    <sys:Double x:Key="DesignCardGap">8</sys:Double>
    <Thickness x:Key="DesignCardPadding">6,6,6,5</Thickness>
    <CornerRadius x:Key="DesignCardRadius">10</CornerRadius>
    <Thickness x:Key="DesignCardBorderThickness">1</Thickness>
    <Thickness x:Key="DesignCardSelectedThickness">2</Thickness>
    <sys:Double x:Key="DesignCardSpacing">5</sys:Double>
    <sys:Double x:Key="DesignNameFontSize">12</sys:Double>

    <!--
      The Classic deck's preview (mockup: .deck, .platter, .vinyl, .tonearm) at 88 x 72: the deck is 1.32 s x 1.08 s with
      s = 66.7; the platter s at .04 s, the record .98 s at .05 s; the arm .14 s wide and .8 s long, .07 s from the
      top right, parked at -4°.
    -->
    <sys:Double x:Key="DesignRowSpacing">10</sys:Double>
    <sys:Double x:Key="DeckPreviewWidth">88</sys:Double>
    <sys:Double x:Key="DeckPreviewHeight">72</sys:Double>
    <CornerRadius x:Key="DeckPreviewRadius">6</CornerRadius>
    <sys:Double x:Key="DeckPreviewPlatterSize">66.7</sys:Double>
    <Thickness x:Key="DeckPreviewPlatterMargin">2.7,2.7,0,0</Thickness>
    <sys:Double x:Key="DeckPreviewPlatterRing">1</sys:Double>
    <sys:Double x:Key="DeckPreviewRecordSize">65.3</sys:Double>
    <Thickness x:Key="DeckPreviewRecordMargin">3.3,3.3,0,0</Thickness>
    <sys:Double x:Key="DeckPreviewGroovePitch">1.2</sys:Double>
    <sys:Double x:Key="DeckPreviewArmWidth">9.3</sys:Double>
    <sys:Double x:Key="DeckPreviewArmHeight">53.3</sys:Double>
    <Thickness x:Key="DeckPreviewArmMargin">0,4.7,4.7,0</Thickness>
    <sys:Double x:Key="DeckPreviewArmBaseSize">9.3</sys:Double>
    <sys:Double x:Key="DeckPreviewTubeWidth">1.6</sys:Double>
    <sys:Double x:Key="DeckPreviewTubeHeight">44</sys:Double>
    <Thickness x:Key="DeckPreviewTubeMargin">0,4.7,0,0</Thickness>
    <sys:Double x:Key="DeckPreviewHeadshellWidth">3.5</sys:Double>
    <sys:Double x:Key="DeckPreviewHeadshellHeight">6.7</sys:Double>
    <Thickness x:Key="DeckPreviewHeadshellMargin">1,0,0,0</Thickness>

    <!--
      Now Playing (mockup: .nowplaying, .np-body, .np-info, .tracklist). The overlay covers the window between the title
      bar and the player bar; its body is two columns, 1.15 : 1, 40 apart, inside 40 x 56 of padding.
    -->
    <Thickness x:Key="NowPlayingPadding">56,40</Thickness>
    <sys:Double x:Key="NowPlayingColumnGap">40</sys:Double>
    <Thickness x:Key="NowPlayingBackgroundInset">-60</Thickness>
    <!-- The blurred background: the small cover made into a 64-pixel image blurred once (Theming/BlurredCover), then
         stretched; it looks like the mockup's live blur(60px) at the cost of one plain image a frame. -->
    <sys:Int32 x:Key="NowPlayingBackgroundPixels">64</sys:Int32>
    <sys:Double x:Key="NowPlayingBackgroundBlur">1.5</sys:Double>
    <sys:Double x:Key="NowPlayingBackgroundOpacity">0.55</sys:Double>
    <sys:Double x:Key="NowPlayingBackgroundScale">1.2</sys:Double>
    <sys:Double x:Key="NowPlayingCloseSize">36</sys:Double>
    <sys:Double x:Key="NowPlayingCloseIconSize">22</sys:Double>
    <CornerRadius x:Key="NowPlayingCloseRadius">18</CornerRadius>
    <Thickness x:Key="NowPlayingCloseMargin">16,12,0,0</Thickness>
    <sys:Double x:Key="NowPlayingInfoMaxWidth">520</sys:Double>
    <!-- The radio kicker: the mockup's 15 icon (in its 24 box), 7 before the text (.np-radio). -->
    <sys:Double x:Key="NowPlayingKickerGap">7</sys:Double>
    <sys:Double x:Key="NowPlayingKickerIconSize">15</sys:Double>
    <sys:Double x:Key="NowPlayingTitleFontSize">40</sys:Double>
    <!-- 6 above and 4 below, less the half-leading line-height 1.05 takes off a 40 px line (3 each side). -->
    <Thickness x:Key="NowPlayingTitleMargin">0,3,0,1</Thickness>
    <sys:Double x:Key="NowPlayingArtistFontSize">18</sys:Double>
    <Thickness x:Key="NowPlayingArtistMargin">0,0,0,22</Thickness>
    <!-- The track list is at most 44% of the window high (mockup: max-height: 44vh). -->
    <sys:Double x:Key="NowPlayingTrackListShare">0.44</sys:Double>
    <Thickness x:Key="NowPlayingTrackPadding">10,8</Thickness>
    <CornerRadius x:Key="NowPlayingTrackRadius">7</CornerRadius>
    <sys:Double x:Key="NowPlayingTrackFontSize">14</sys:Double>
    <sys:Double x:Key="NowPlayingTrackNumberWidth">28</sys:Double>
    <sys:Double x:Key="NowPlayingTrackGap">10</sys:Double>

    <!--
      The Classic deck (mockup: .deck), drawn at s = 400 (DeckView.BaseSize; the host scales it to min(46vh, 34vw)): the
      plinth 1.32 s x 1.08 s; the platter s at .04 s, its ring 4; the record .98 s at .05 s; the LED 7 at 18 x 14 from
      the bottom left; "Music Spin" .03 s high, .055 s x .042 s from the bottom right, its letters .32 em apart. The arm
      box .14 s x .8 s, .07 s from the top right, turning about its middle .07 s down: the base .14 s round on top, the
      tube 5 wide and .66 s long from .07 s, the headshell 18 x .1 s at the bottom, 30% of its width left of the middle,
      turned 18°.
    -->
    <sys:Double x:Key="DeckWidth">528</sys:Double>
    <!-- The designs on the studies' bench (Styles/Decks.axaml) draw in deck units, 1320 × 1080, scaled to DeckWidth:
         0.4 px each, so their record's grooves are 2.4 / 0.4 units apart. -->
    <sys:Double x:Key="KitDeckUnits">1320</sys:Double>
    <!-- DeckWidth / KitDeckUnits: what a kit deck tells its host (controls:DeckView.UnitScale). -->
    <sys:Double x:Key="KitDeckUnitScale">0.4</sys:Double>
    <sys:Double x:Key="KitDeckUnitsHigh">1080</sys:Double>
    <sys:Double x:Key="KitGroovePitch">6</sys:Double>
    <sys:Double x:Key="DeckHeight">432</sys:Double>
    <CornerRadius x:Key="DeckRadius">18</CornerRadius>
    <sys:Double x:Key="DeckPlatterSize">400</sys:Double>
    <Thickness x:Key="DeckPlatterMargin">16,16,0,0</Thickness>
    <sys:Double x:Key="DeckPlatterRing">4</sys:Double>
    <sys:Double x:Key="DeckPlatterStripe">2</sys:Double>
    <sys:Double x:Key="DeckRecordSize">392</sys:Double>
    <Thickness x:Key="DeckRecordMargin">20,20,0,0</Thickness>
    <sys:Double x:Key="DeckLedSize">7</sys:Double>
    <Thickness x:Key="DeckLedMargin">18,0,0,14</Thickness>
    <sys:Double x:Key="DeckLedGlow">10</sys:Double>
    <sys:Double x:Key="DeckBrandFontSize">12</sys:Double>
    <sys:Double x:Key="DeckBrandLetterSpacing">3.84</sys:Double>
    <Thickness x:Key="DeckBrandMargin">0,0,18.16,16.8</Thickness>
    <Thickness x:Key="DeckBrandHighlightMargin">0,0,18.16,15.8</Thickness>
    <Thickness x:Key="DeckBrandShadeMargin">0,0,18.16,17.8</Thickness>
    <sys:Double x:Key="DeckArmWidth">56</sys:Double>
    <sys:Double x:Key="DeckArmHeight">320</sys:Double>
    <Thickness x:Key="DeckArmMargin">0,28,28,0</Thickness>
    <sys:Double x:Key="DeckArmBaseSize">56</sys:Double>
    <CornerRadius x:Key="DeckArmBaseRadius">28</CornerRadius>
    <sys:Double x:Key="DeckTubeWidth">5</sys:Double>
    <sys:Double x:Key="DeckTubeHeight">264</sys:Double>
    <Thickness x:Key="DeckTubeMargin">0,28,0,0</Thickness>
    <CornerRadius x:Key="DeckTubeRadius">3</CornerRadius>
    <sys:Double x:Key="DeckHeadshellWidth">18</sys:Double>
    <sys:Double x:Key="DeckHeadshellHeight">40</sys:Double>
    <Thickness x:Key="DeckHeadshellMargin">22.6,0,0,0</Thickness>
    <sys:Double x:Key="DeckArmShadowBlur">4</sys:Double>
    <!-- Room around the arm's shadow, drawn once into an image: its turned headshell and blur fall inside. -->
    <Thickness x:Key="DeckCacheFrame">-16</Thickness>

    <!--
      The queue drawer (mockup: .queue): 340 wide on the right, from under the title bar to the player bar. The header
      16 18 10 18 with "Up next" at 15 and the summary at 12; Clear 3 x 8, radius 6; ✕ 28 round. The list is padded 0 8
      10; a row (.qi) 6 x 8, radius 7, columns 36 | title | duration | 24 (✕, 24 round, its icon 9), 10 apart, at 13 with
      the artist at 11.5 and the duration at 12. The drop line is 2 high, 12 from the list's sides (4 past a row). The
      empty box: 4 x 10 out, 34 x 16 in, a 1.5 dashed line, radius 12, text at 13 on 1.5 lines. The footer is padded 12
      14 with 8 between its buttons, 6 in the name form, where the buttons are 8 x 14 and the field 0 x 12 at 13. The
      radio part is 14 below the rows: its header 12 8 6 8 with an 8 gap at 12, its icon 15.
    -->
    <sys:Double x:Key="QueueWidth">340</sys:Double>
    <Thickness x:Key="QueueHeaderPadding">18,16,12,10</Thickness>
    <sys:Double x:Key="QueueHeaderGap">8</sys:Double>
    <sys:Double x:Key="QueueTitleFontSize">15</sys:Double>
    <sys:Double x:Key="QueueSummaryFontSize">12</sys:Double>
    <Thickness x:Key="QueueTextButtonPadding">8,3</Thickness>
    <CornerRadius x:Key="QueueTextButtonRadius">6</CornerRadius>
    <sys:Double x:Key="QueueTextButtonFontSize">12</sys:Double>
    <sys:Double x:Key="QueueCloseSize">28</sys:Double>
    <CornerRadius x:Key="QueueCloseRadius">14</CornerRadius>
    <sys:Double x:Key="QueueCloseIconSize">12</sys:Double>
    <Thickness x:Key="QueueListPadding">8,0,8,10</Thickness>
    <Thickness x:Key="QueueRowPadding">8,6</Thickness>
    <CornerRadius x:Key="QueueRowRadius">7</CornerRadius>
    <sys:Double x:Key="QueueRowGap">10</sys:Double>
    <sys:Double x:Key="QueueRowFontSize">13</sys:Double>
    <sys:Double x:Key="QueueRowArtistFontSize">11.5</sys:Double>
    <sys:Double x:Key="QueueRowDurationFontSize">12</sys:Double>
    <GridLength x:Key="QueueRemoveColumn">24</GridLength>
    <sys:Double x:Key="QueueRemoveSize">24</sys:Double>
    <CornerRadius x:Key="QueueRemoveRadius">12</CornerRadius>
    <sys:Double x:Key="QueueRemoveIconSize">9</sys:Double>
    <Thickness x:Key="QueueRemoveMargin">0,0,8,0</Thickness>
    <sys:Double x:Key="QueueDraggedOpacity">0.35</sys:Double>
    <sys:Double x:Key="QueuePickOpacity">0.6</sys:Double>
    <sys:Double x:Key="QueueDropLineHeight">2</sys:Double>
    <CornerRadius x:Key="QueueDropLineRadius">1</CornerRadius>
    <Thickness x:Key="QueueDropLineMargin">4,0</Thickness>
    <Thickness x:Key="QueueEmptyMargin">10,4</Thickness>
    <Thickness x:Key="QueueEmptyTextMargin">16,34</Thickness>
    <sys:Double x:Key="QueueEmptyDashWidth">1.5</sys:Double>
    <sys:Double x:Key="QueueEmptyRadius">12</sys:Double>
    <sys:Double x:Key="QueueEmptyFontSize">13</sys:Double>
    <sys:Double x:Key="QueueEmptyLineHeight">19.5</sys:Double>
    <sys:Double x:Key="QueueEmptyIconSize">10</sys:Double>
    <Thickness x:Key="QueueFooterPadding">14,12</Thickness>
    <sys:Double x:Key="QueueFooterGap">8</sys:Double>
    <sys:Double x:Key="QueueFormGap">6</sys:Double>
    <Thickness x:Key="QueueFormButtonPadding">14,8</Thickness>
    <Thickness x:Key="QueueNamePadding">12,0</Thickness>
    <CornerRadius x:Key="QueueNameRadius">999</CornerRadius>
    <sys:Double x:Key="QueueNameFontSize">13</sys:Double>
    <Thickness x:Key="QueueRadioMargin">0,14,0,0</Thickness>
    <Thickness x:Key="QueueRadioHeaderPadding">8,12,8,6</Thickness>
    <sys:Double x:Key="QueueRadioHeaderGap">8</sys:Double>
    <sys:Double x:Key="QueueRadioFontSize">12</sys:Double>
    <sys:Double x:Key="QueueRadioIconSize">15</sys:Double>
    <sys:Double x:Key="QueueRadioIconStroke">2</sys:Double>

    <!--
      The drag ghost (mockup: .drag-ghost): at most 260 wide, padded 6 14 6 6, radius 9, a 40 cover 10 from the text at
      12.5; the pointer holds it 24 in from its top left (setDragImage(ghost, 24, 24)). A drag starts once the pointer has
      moved 4 from where it was pressed.
    -->
    <sys:Double x:Key="GhostMaxWidth">260</sys:Double>
    <Thickness x:Key="GhostPadding">6,6,14,6</Thickness>
    <CornerRadius x:Key="GhostRadius">9</CornerRadius>
    <sys:Double x:Key="GhostFontSize">12.5</sys:Double>
    <sys:Double x:Key="GhostGap">10</sys:Double>
    <sys:Double x:Key="GhostCoverSize">40</sys:Double>
    <sys:Double x:Key="GhostGrip">24</sys:Double>
    <sys:Double x:Key="DragThreshold">4</sys:Double>
</ResourceDictionary>
