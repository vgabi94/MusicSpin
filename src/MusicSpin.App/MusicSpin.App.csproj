<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Music Spin desktop app (Avalonia 12). Structure: docs/architecture.md, "Desktop app".
    Styles/ holds every value a view uses; ViewModels/ hold the state and logic; Services/ talk to Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Desktop executable: MusicSpin(.exe) / MusicSpin.app. The CLI is music-spin(.exe), so no case-insensitive clash. -->
    <AssemblyName>MusicSpin</AssemblyName>
    <RootNamespace>MusicSpin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The Windows media controls call WinRT through vtable function pointers (Services/MediaControls/WinRT.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicSpin.Core\MusicSpin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicSpin.Tests.Ui" />
  </ItemGroup>
  <Import Project="..\..\eng\Publish.props" />
</Project>
