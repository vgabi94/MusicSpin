<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Music Spin desktop app (Avalonia 12). Structure: docs/architecture.md, "Desktop app".
    Styles/ holds every value a view uses; ViewModels/ hold the state and logic; Services/ talk to Core.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Desktop executable: MusicSpin(.exe) / MusicSpin.app. The CLI is music-spin(.exe), so no case-insensitive clash. -->
    <AssemblyName>MusicSpin</AssemblyName>
    <RootNamespace>MusicSpin.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- MusicSpin.exe's icon (#187), made from Assets/AppIcon/app-icon.svg by eng/make-app-icon.cs. -->
    <ApplicationIcon>Assets\AppIcon\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The macOS and Windows media controls call the Objective-C runtime and WinRT through function pointers (Services/MediaControls/ObjC.cs, WinRT.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Svg.Controls.Avalonia" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <!-- The turntable designs' drawings and fonts (#25–#30). -->
    <AvaloniaResource Include="Assets\**" />
    <!--
      The app icon (#187): only the window's icon and the tray's are loaded at run time. The master and the macOS and
      Linux files are inputs to the publish scripts, so they stay out of the executable.
    -->
    <AvaloniaResource Remove="Assets\AppIcon\**" />
    <AvaloniaResource Include="Assets\AppIcon\app-icon.ico;Assets\AppIcon\app-icon-64.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicSpin.Core\MusicSpin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicSpin.Tests.Ui" />
  </ItemGroup>
  <Import Project="..\..\eng\Publish.props" />
</Project>
