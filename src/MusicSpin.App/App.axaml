<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MusicSpin.App.App"
             RequestedThemeVariant="Default">
    <!-- Avalonia's default theme, required to render anything. Real styling comes with the UI design. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
