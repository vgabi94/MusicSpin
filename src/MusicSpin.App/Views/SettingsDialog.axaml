<!--
  Settings (mockup: #setBack .dlg): Appearance (theme, Motion), Turntable (speed, vinyl transition, design), Shelf (tilt, depth). Every
  change applies at once and is saved; there is no Save button. The window shows it over a dim (MainWindow.axaml).
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicSpin.App.ViewModels"
             xmlns:services="using:MusicSpin.App.Services"
             xmlns:controls="using:MusicSpin.App.Controls"
             xmlns:theming="using:MusicSpin.App.Theming"
             x:Class="MusicSpin.App.Views.SettingsDialog"
             x:DataType="vm:SettingsViewModel">
    <UserControl.DataTemplates>
        <!-- Each design's preview; each deck adds its own. -->
        <DataTemplate DataType="services:ClassicDeck">
            <Panel Classes="deckPreview classic">
                <Border Classes="plinth" />
                <Ellipse Classes="platter" />
                <controls:VinylView Classes="record" />
                <Panel Classes="tonearm">
                    <Border Classes="arm" />
                    <Border Classes="headshell" />
                    <Ellipse Classes="armBase" />
                </Panel>
            </Panel>
        </DataTemplate>
        <!-- The designs from the deck studies (#25–#30), drawn by their own deck, small and parked. -->
        <DataTemplate DataType="services:WalnutDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource WalnutDeck}" />
            </Viewbox>
        </DataTemplate>
        <DataTemplate DataType="services:AluminiumDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource AluminiumDeck}" />
            </Viewbox>
        </DataTemplate>
        <DataTemplate DataType="services:CarbonDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource CarbonDeck}" />
            </Viewbox>
        </DataTemplate>
        <DataTemplate DataType="services:PianoDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource PianoDeck}" />
            </Viewbox>
        </DataTemplate>
        <DataTemplate DataType="services:LinearDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource LinearDeck}" />
            </Viewbox>
        </DataTemplate>
        <DataTemplate DataType="services:AcrylicDeck">
            <Viewbox Classes="deckPreview">
                <controls:KitDeckView Theme="{StaticResource AcrylicDeck}" />
            </Viewbox>
        </DataTemplate>
        <!-- An equalizer slider, upright: its gain over it, a tick at 0 dB behind it, its band (or "Pre") under it. -->
        <DataTemplate DataType="vm:EqualizerSliderViewModel">
            <StackPanel Classes="eqSlider">
                <TextBlock Classes="eqGain" Text="{Binding GainText}" />
                <Panel>
                    <Border Classes="eqZero" />
                    <LayoutTransformControl Classes="upright">
                        <controls:ScrubBar Classes="eq"
                                           Minimum="{x:Static vm:EqualizerViewModel.MinGain}"
                                           Maximum="{x:Static vm:EqualizerViewModel.MaxGain}"
                                           Value="{Binding Gain, Mode=OneWay}"
                                           CommitCommand="{Binding SetGainCommand}"
                                           Scrub="{Binding Scrub}"
                                           ValueText="{Binding ValueText}"
                                           AutomationProperties.Name="{Binding Name}" />
                    </LayoutTransformControl>
                </Panel>
                <TextBlock Classes="eqBand" Text="{Binding Label}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Name="Dialog"
            Classes="dialog"
            AutomationProperties.Name="Settings"
            theming:Animate.Play="DialogInAnimation"
            theming:Animate.Trigger="{Binding Opens}">
        <ScrollViewer>
            <StackPanel>
                <Grid Classes="dialogHeader" ColumnDefinitions="*,Auto">
                    <TextBlock Name="SettingsTitle" Classes="dialogTitle" Text="Settings" />
                    <Button Name="CloseSettings"
                            Grid.Column="1"
                            Classes="dialogClose"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close (Esc)"
                            AutomationProperties.Name="Close Settings">
                        <controls:Icon Data="{StaticResource Close}" />
                    </Button>
                </Grid>

                <TextBlock Classes="settingsSection" Text="APPEARANCE" />
                <Border Classes="settingRow">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Theme" />
                        <ListBox Name="ThemeChoice"
                                 Grid.Column="1"
                                 Theme="{StaticResource Segmented}"
                                 ItemsSource="{Binding Themes}"
                                 SelectedItem="{Binding ThemeChoice}"
                                 AutomationProperties.Name="Theme" />
                    </Grid>
                </Border>
                <Border Classes="settingRow next">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Motion" />
                            <TextBlock Classes="settingNote" Text="The record spins in every mode" />
                        </StackPanel>
                        <ListBox Name="MotionChoice"
                                 Grid.Column="1"
                                 Theme="{StaticResource Segmented}"
                                 ItemsSource="{Binding Motions}"
                                 SelectedItem="{Binding MotionChoice}"
                                 AutomationProperties.Name="Motion" />
                    </Grid>
                </Border>

                <TextBlock Classes="settingsSection" Text="TURNTABLE" />
                <Border Classes="settingRow">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Speed" />
                        <ListBox Name="SpeedChoice"
                                 Grid.Column="1"
                                 Theme="{StaticResource Segmented}"
                                 ItemsSource="{Binding Speeds}"
                                 SelectedItem="{Binding SpeedChoice}"
                                 AutomationProperties.Name="Record speed" />
                    </Grid>
                </Border>
                <Border Classes="settingRow next">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Vinyl transition" />
                            <TextBlock Classes="settingNote" Text="{x:Static vm:SettingsViewModel.VinylTransitionNote}" />
                        </StackPanel>
                        <ToggleButton Name="VinylTransition"
                                      Grid.Column="1"
                                      Theme="{StaticResource Switch}"
                                      IsChecked="{Binding VinylTransition}"
                                      AutomationProperties.Name="Vinyl transition" />
                    </Grid>
                </Border>
                <!-- Seven designs: they wrap under the label. -->
                <Border Classes="settingRow next tall">
                    <StackPanel Classes="designRow">
                        <TextBlock Text="Design" />
                        <ListBox Name="DesignChoice"
                                 Theme="{StaticResource Cards}"
                                 ItemsSource="{Binding Designs}"
                                 SelectedItem="{Binding Design}"
                                 AutomationProperties.Name="Turntable design">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="services:DeckDesign">
                                    <StackPanel Classes="designCard">
                                        <ContentControl Content="{Binding}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <TextBlock Classes="settingsSection" Text="SHELF" />
                <Border Classes="settingRow">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Tilt" />
                        <StackPanel Grid.Column="1" Classes="range">
                            <controls:ScrubBar Name="TiltBar"
                                               Classes="setting"
                                               Minimum="{x:Static vm:SettingsViewModel.MinTilt}"
                                               Maximum="{x:Static vm:SettingsViewModel.MaxTilt}"
                                               Value="{Binding ShelfTilt, Mode=OneWay}"
                                               CommitCommand="{Binding SetShelfTiltCommand}"
                                               Scrub="{Binding TiltScrub}"
                                               ValueText="{Binding ShelfTiltText}"
                                               AutomationProperties.Name="Shelf tilt" />
                            <TextBlock Name="TiltText" Text="{Binding ShelfTiltText}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Classes="settingRow next">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="Depth" />
                            <TextBlock Classes="settingNote" Text="0 is flat, higher looks deeper" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="range">
                            <controls:ScrubBar Name="DepthBar"
                                               Classes="setting"
                                               Minimum="{x:Static vm:SettingsViewModel.MinDepth}"
                                               Maximum="{x:Static vm:SettingsViewModel.MaxDepth}"
                                               Value="{Binding ShelfDepth, Mode=OneWay}"
                                               CommitCommand="{Binding SetShelfDepthCommand}"
                                               Scrub="{Binding DepthScrub}"
                                               ValueText="{Binding ShelfDepthText}"
                                               AutomationProperties.Name="Shelf depth" />
                            <TextBlock Name="DepthText" Text="{Binding ShelfDepthText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--
                  Library (#31): the music folders (a missing one says so), Add folder…, the scan (its progress and Cancel
                  while it runs, else when it last ran), Watch folders, and what the last scan couldn't read.
                -->
                <StackPanel Name="LibrarySection" IsVisible="{Binding Library, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="settingsSection" Text="LIBRARY" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Music folders" />
                                <TextBlock Name="AddOutcome"
                                           Classes="settingNote"
                                           Text="{Binding Library.Outcome, FallbackValue={x:Null}}"
                                           IsVisible="{Binding Library.Outcome, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                            </StackPanel>
                            <Button Name="AddFolder" Grid.Column="1" Classes="settingButton" Content="Add folder…" Command="{Binding Library.AddFolderCommand, FallbackValue={x:Null}}" />
                        </Grid>
                    </Border>
                    <ItemsControl Name="LibraryFolders" Classes="libraryFolders" ItemsSource="{Binding Library.Folders, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:LibraryFolderViewModel">
                                <Border Classes="settingRow next">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Classes="folderPath" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />
                                            <TextBlock Classes="settingNote" Classes.missing="{Binding !IsReachable}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="settingButton"
                                                Content="Remove"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).Library.RemoveCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{Binding Path, StringFormat='Remove {0}'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Classes="settingRow next">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Scan" />
                                <TextBlock Name="ScanNote" Classes="settingNote" Text="{Binding Library.ScanNote, FallbackValue={x:Null}}" />
                            </StackPanel>
                            <Panel Grid.Column="1">
                                <Button Name="Rescan"
                                        Classes="settingButton"
                                        Content="Rescan"
                                        Command="{Binding Library.RescanCommand, FallbackValue={x:Null}}"
                                        IsVisible="{Binding !Library.Scan.IsScanning, FallbackValue=False}" />
                                <Button Name="CancelScan"
                                        Classes="settingButton"
                                        Content="Cancel"
                                        Command="{Binding Library.Scan.CancelCommand, FallbackValue={x:Null}}"
                                        IsVisible="{Binding Library.Scan.IsScanning, FallbackValue=False}" />
                            </Panel>
                        </Grid>
                    </Border>
                    <Border Classes="settingRow next">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Watch folders" />
                                <TextBlock Classes="settingNote" Text="Keep the library up to date while the app runs" />
                            </StackPanel>
                            <ToggleButton Name="WatchFolders"
                                          Grid.Column="1"
                                          Theme="{StaticResource Switch}"
                                          IsChecked="{Binding Library.WatchFolders, FallbackValue=False}"
                                          AutomationProperties.Name="Watch folders" />
                        </Grid>
                    </Border>
                    <StackPanel Name="ScanIssues" Classes="scanIssues" IsVisible="{Binding Library.HasIssues, FallbackValue=False}">
                        <Button Name="IssuesLink" Classes="link" Content="{Binding Library.IssuesText, FallbackValue={x:Null}}" Command="{Binding Library.ToggleIssuesCommand, FallbackValue={x:Null}}" />
                        <ItemsControl Name="IssueList" ItemsSource="{Binding Library.Issues, FallbackValue={x:Null}}" IsVisible="{Binding Library.ShowsIssues, FallbackValue=False}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:LibraryIssueViewModel">
                                    <StackPanel Classes="scanIssue">
                                        <TextBlock Classes="folderPath" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />
                                        <TextBlock Classes="settingNote" Text="{Binding Message}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!--
                  Audio (#32): the output device (System default, then the devices; one saved but not plugged in says so)
                  and exclusive mode. A change restarts the player, so both wait while it does. The note under Output says
                  what the player plays through now.
                -->
                <StackPanel Name="AudioSection" IsVisible="{Binding Audio, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Classes="settingsSection" Text="AUDIO" />
                    <Border Classes="settingRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Output" />
                                <TextBlock Name="InUse"
                                           Classes="settingNote wraps"
                                           Text="{Binding Audio.InUse, FallbackValue={x:Null}}"
                                           IsVisible="{Binding Audio.InUse, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                            </StackPanel>
                            <Button Name="OutputDevice"
                                    Grid.Column="1"
                                    Classes="dropdown settingDropdown"
                                    Command="{Binding Audio.OpenDeviceMenuCommand, FallbackValue={x:Null}}"
                                    AutomationProperties.Name="Output device">
                                <StackPanel>
                                    <TextBlock Classes="chosen" Text="{Binding Audio.DeviceLabel, FallbackValue={x:Null}}" />
                                    <controls:Icon Data="{StaticResource ChevronDown}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Border Classes="settingRow next">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Exclusive mode" />
                                <TextBlock Classes="settingNote" Text="{x:Static vm:AudioSettingsViewModel.ExclusiveNote}" />
                            </StackPanel>
                            <ToggleButton Name="ExclusiveMode"
                                          Grid.Column="1"
                                          Theme="{StaticResource Switch}"
                                          IsChecked="{Binding Audio.Exclusive, FallbackValue=False}"
                                          IsEnabled="{Binding !Audio.IsRestarting, FallbackValue=False}"
                                          AutomationProperties.Name="Exclusive mode" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow next">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Volume levelling" />
                                <TextBlock Classes="settingNote" Text="{x:Static vm:AudioSettingsViewModel.LevellingNote}" />
                            </StackPanel>
                            <ToggleButton Name="VolumeLevelling"
                                          Grid.Column="1"
                                          Theme="{StaticResource Switch}"
                                          IsChecked="{Binding Audio.Levelling, FallbackValue=False}"
                                          AutomationProperties.Name="Volume levelling" />
                        </Grid>
                    </Border>

                    <!--
                      Equalizer (#141; not in the mockup, so in the dialog's own look): the switch (its note says how far
                      boosts lower the pre-amp), the preset and Reset, the pre-amp and the ten bands upright, then saving
                      the gains as a preset, and deleting a saved one. Applies at once, without a restart.
                    -->
                    <Border Classes="settingRow next">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Equalizer" />
                                <TextBlock Name="EqualizerNote"
                                           Classes="settingNote"
                                           Text="{Binding Audio.Equalizer.HeadroomNote, FallbackValue={x:Null}, TargetNullValue={x:Static vm:EqualizerViewModel.Note}}" />
                            </StackPanel>
                            <ToggleButton Name="EqualizerSwitch"
                                          Grid.Column="1"
                                          Theme="{StaticResource Switch}"
                                          IsChecked="{Binding Audio.Equalizer.Enabled, FallbackValue=False}"
                                          AutomationProperties.Name="Equalizer" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow next">
                        <Grid Classes="eqPreset" ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Text="Preset" />
                            <Button Name="EqualizerPreset"
                                    Grid.Column="1"
                                    Classes="dropdown settingDropdown"
                                    Command="{Binding Audio.Equalizer.OpenPresetMenuCommand, FallbackValue={x:Null}}"
                                    AutomationProperties.Name="Equalizer preset">
                                <StackPanel>
                                    <TextBlock Classes="chosen" Text="{Binding Audio.Equalizer.PresetLabel, FallbackValue={x:Null}}" />
                                    <controls:Icon Data="{StaticResource ChevronDown}" />
                                </StackPanel>
                            </Button>
                            <Button Name="EqualizerReset"
                                    Grid.Column="2"
                                    Classes="settingButton"
                                    Content="Reset"
                                    Command="{Binding Audio.Equalizer.ResetCommand, FallbackValue={x:Null}}"
                                    AutomationProperties.Name="Reset the equalizer" />
                        </Grid>
                    </Border>
                    <Border Classes="settingRow tall">
                        <Grid Name="EqualizerSliders" Classes="eqSliders" ColumnDefinitions="Auto,*">
                            <ContentControl Name="EqualizerPreamp" Content="{Binding Audio.Equalizer.Preamp, FallbackValue={x:Null}}" />
                            <ItemsControl Name="EqualizerBands" Grid.Column="1" ItemsSource="{Binding Audio.Equalizer.Bands, FallbackValue={x:Null}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <Border Classes="settingRow next">
                        <Grid Classes="eqPreset" ColumnDefinitions="*,Auto,Auto">
                            <StackPanel>
                                <TextBox Name="EqualizerPresetName"
                                         Classes="presetName"
                                         Text="{Binding Audio.Equalizer.NewPresetName, FallbackValue={x:Null}}"
                                         PlaceholderText="Name these settings"
                                         MaxLength="{x:Static vm:EqualizerViewModel.MaxNameLength}"
                                         AutomationProperties.Name="Preset name">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding Audio.Equalizer.SavePresetCommand, FallbackValue={x:Null}}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <TextBlock Name="EqualizerPresetProblem"
                                           Classes="settingNote missing"
                                           Text="{Binding Audio.Equalizer.PresetProblem, FallbackValue={x:Null}}"
                                           IsVisible="{Binding Audio.Equalizer.PresetProblem, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
                            </StackPanel>
                            <Button Name="EqualizerSavePreset"
                                    Grid.Column="1"
                                    Classes="settingButton"
                                    Content="Save preset"
                                    Command="{Binding Audio.Equalizer.SavePresetCommand, FallbackValue={x:Null}}" />
                            <Button Name="EqualizerDeletePreset"
                                    Grid.Column="2"
                                    Classes="settingButton"
                                    Content="Delete"
                                    Command="{Binding Audio.Equalizer.AskDeletePresetCommand, FallbackValue={x:Null}}"
                                    IsVisible="{Binding Audio.Equalizer.IsUserPreset, FallbackValue=False}"
                                    AutomationProperties.Name="{Binding Audio.Equalizer.PresetLabel, StringFormat='Delete the preset {0}', FallbackValue={x:Null}}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
