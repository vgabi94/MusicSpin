<!--
  The title bar (mockup: .titlebar, #135): the title, the app menu after it, an empty stretch, the search box, and room
  for the system window buttons, which the platform draws over it (Panel.captionButtons). The bar drags the window and a
  double-click maximizes it; the menu and the search box take their own input. On macOS the menu is in the menu bar (the
  NativeMenuBar then shows nothing) and the window buttons are on the left.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicSpin.App.ViewModels"
             xmlns:controls="using:MusicSpin.App.Controls"
             xmlns:chrome="using:Avalonia.Controls.Chrome"
             x:Class="MusicSpin.App.Views.TitleBar"
             x:DataType="vm:MainWindowViewModel">
    <Border Classes="titleBar" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Classes="brand">
                <Panel Classes="brandDisc">
                    <Ellipse Classes="brandRecord" />
                    <Ellipse Classes="brandRing" />
                    <Ellipse Classes="brandLabel" />
                </Panel>
                <TextBlock Classes="brandName" Text="Music Spin" />
            </StackPanel>
            <NativeMenuBar Name="AppMenuBar"
                           Grid.Column="1"
                           Classes="appMenu"
                           AutomationProperties.Name="Menu"
                           chrome:WindowDecorationProperties.ElementRole="User" />
            <Panel Name="DragArea" Grid.Column="2" />
            <Border Grid.Column="3" Classes="search" chrome:WindowDecorationProperties.ElementRole="User">
                <Grid ColumnDefinitions="Auto,*">
                    <controls:Icon Data="{StaticResource MagnifyingGlassLight}" />
                    <TextBox Name="SearchBox"
                             Grid.Column="1"
                             Classes="search"
                             PlaceholderText="Search"
                             AutomationProperties.Name="Search"
                             Text="{Binding SearchText}" />
                </Grid>
            </Border>
            <Panel Grid.Column="4" Classes="captionButtons" />
        </Grid>
    </Border>
</UserControl>
