<!--
  The window (mockup: .window): title bar, sidebar | content, player bar. Sizes and looks are in Styles/; this file is
  structure and bindings only (tests/MusicSpin.Tests.Ui guards that).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicSpin.App.ViewModels"
        xmlns:views="using:MusicSpin.App.Views"
        xmlns:pages="using:MusicSpin.App.Views.Pages"
        xmlns:controls="using:MusicSpin.App.Controls"
        x:Class="MusicSpin.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="shell"
        Icon="avares://MusicSpin/Assets/AppIcon/app-icon.ico"
        Title="Music Spin">
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Gesture="Space" Command="{Binding SpaceCommand}" />
        <KeyBinding Gesture="Ctrl+Right" Command="{Binding SeekForwardCommand}" />
        <KeyBinding Gesture="Ctrl+Left" Command="{Binding SeekBackCommand}" />
        <KeyBinding Gesture="Ctrl+Up" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Gesture="Ctrl+Down" Command="{Binding VolumeDownCommand}" />
        <KeyBinding Gesture="Right" Command="{Binding FlipCrateOnCommand}" />
        <KeyBinding Gesture="Down" Command="{Binding FlipCrateOnCommand}" />
        <KeyBinding Gesture="Left" Command="{Binding FlipCrateBackCommand}" />
        <KeyBinding Gesture="Up" Command="{Binding FlipCrateBackCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:AlbumsPageViewModel">
            <pages:AlbumsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:TrackListPageViewModel">
            <pages:TracksPage />
        </DataTemplate>
        <DataTemplate DataType="vm:RadioPageViewModel">
            <pages:RadioPage />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource PlayerBarHeight}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:TitleBar Name="TitleBarView" Grid.ColumnSpan="2" />

        <!--
          Under Now Playing, once it covers them, the sidebar and the page aren't drawn (their records would turn unseen);
          while it or the queue drawer moves over them, they are drawn from an image (.underMotion).
        -->
        <views:SidebarView Name="SidebarView"
                           Grid.Row="1"
                           DataContext="{Binding Sidebar}"
                           IsVisible="{Binding #NowPlayingLayer.Covers, Converter={x:Static BoolConverters.Not}}">
            <Classes.underMotion>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding ElementName="NowPlayingLayer" Path="IsMoving" />
                    <Binding ElementName="QueueLayer" Path="IsMoving" />
                </MultiBinding>
            </Classes.underMotion>
        </views:SidebarView>

        <DockPanel Name="ContentArea" Grid.Row="1" Grid.Column="1" IsVisible="{Binding #NowPlayingLayer.Covers, Converter={x:Static BoolConverters.Not}}">
            <Classes.underMotion>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding ElementName="NowPlayingLayer" Path="IsMoving" />
                    <Binding ElementName="QueueLayer" Path="IsMoving" />
                </MultiBinding>
            </Classes.underMotion>
            <Border Name="Banner"
                    Classes="banner"
                    DockPanel.Dock="Top"
                    IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="BannerText" Text="{Binding Banner}" />
                    <Button Name="DismissBanner"
                            Grid.Column="1"
                            Command="{Binding DismissBannerCommand}"
                            ToolTip.Tip="Dismiss"
                            AutomationProperties.Name="Dismiss">
                        <controls:Icon Data="{StaticResource Close}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Name="Toolbar" Classes="toolbar" DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                <StackPanel Classes="pageHeading">
                    <TextBlock Name="PageTitle" Classes="pageTitle" Text="{Binding CurrentPage.Title}" />
                    <TextBlock Name="PageCount" Classes="pageCount" Text="{Binding CurrentPage.CountText}" />
                </StackPanel>
                <!-- Page-specific controls: the first template that fits the page; others show nothing. -->
                <ContentControl Name="PageActions" Grid.Column="1" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:AlbumsPageViewModel">
                            <Panel>
                                <ListBox Name="ViewSwitch"
                                         Classes="viewSwitch"
                                         Theme="{StaticResource Segmented}"
                                         ItemsSource="{Binding Views}"
                                         SelectedItem="{Binding ViewChoice}"
                                         AutomationProperties.Name="View" />
                                <StackPanel Classes="sort">
                                    <Button Name="SortButton" Classes="dropdown" Command="{Binding OpenSortMenuCommand}" AutomationProperties.Name="Sort">
                                        <StackPanel>
                                            <TextBlock Text="Sort: " />
                                            <TextBlock Classes="chosen" Text="{Binding Sort}" />
                                            <controls:Icon Data="{StaticResource ChevronDown}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Name="GroupButton" Classes="dropdown" Command="{Binding OpenGroupMenuCommand}" AutomationProperties.Name="Group">
                                        <StackPanel>
                                            <TextBlock Text="Group: " />
                                            <TextBlock Classes="chosen" Text="{Binding Grouping}" />
                                            <controls:Icon Data="{StaticResource ChevronDown}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TracksPageViewModel">
                            <StackPanel Classes="sort">
                                <Button Name="SortButton" Classes="dropdown" Command="{Binding OpenSortMenuCommand}" AutomationProperties.Name="Sort">
                                    <StackPanel>
                                        <TextBlock Text="Sort: " />
                                        <TextBlock Classes="chosen" Text="{Binding Sort}" />
                                        <controls:Icon Data="{StaticResource ChevronDown}" />
                                    </StackPanel>
                                </Button>
                                <Button Name="GroupButton" Classes="dropdown" Command="{Binding OpenGroupMenuCommand}" AutomationProperties.Name="Group">
                                    <StackPanel>
                                        <TextBlock Text="Group: " />
                                        <TextBlock Classes="chosen" Text="{Binding Grouping}" />
                                        <controls:Icon Data="{StaticResource ChevronDown}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        <!-- Favorites (#48): Play, then Radio (a station of favorites; "On air" while it plays), then Queue. -->
                        <DataTemplate DataType="vm:FavoritesPageViewModel">
                            <StackPanel Classes="pageActions">
                                <Button Name="PlayAll" Classes="accent" Command="{Binding PlayAllCommand}" AutomationProperties.Name="Play">
                                    <StackPanel>
                                        <controls:Icon Data="{StaticResource Play}" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button Name="FavoritesRadio"
                                        Classes="accent ghost"
                                        Command="{Binding RadioCommand}"
                                        AutomationProperties.Name="{Binding RadioLabel}">
                                    <StackPanel>
                                        <controls:Icon Classes="stroke" Data="{StaticResource Radio}" />
                                        <TextBlock Text="{Binding RadioLabel}" />
                                    </StackPanel>
                                </Button>
                                <Button Name="QueueAll" Classes="accent ghost" Command="{Binding QueueAllCommand}" AutomationProperties.Name="Queue">
                                    <StackPanel>
                                        <controls:Icon Data="{StaticResource Plus}" />
                                        <TextBlock Text="Queue" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TrackListPageViewModel">
                            <StackPanel Classes="pageActions">
                                <Button Name="PlayAll" Classes="accent" Command="{Binding PlayAllCommand}" AutomationProperties.Name="Play">
                                    <StackPanel>
                                        <controls:Icon Data="{StaticResource Play}" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button Name="QueueAll" Classes="accent ghost" Command="{Binding QueueAllCommand}" AutomationProperties.Name="Queue">
                                    <StackPanel>
                                        <controls:Icon Data="{StaticResource Plus}" />
                                        <TextBlock Text="Queue" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:PageViewModel">
                            <Panel />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Grid>

            <!-- Favorites: how many favorites aren't in the library now, and where the CLI lists them. -->
            <StackPanel Name="MissingNote"
                        Classes="pageNote"
                        DockPanel.Dock="Top"
                        IsVisible="{Binding ((vm:FavoritesPageViewModel)CurrentPage).MissingNote, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
                <TextBlock Text="{Binding ((vm:FavoritesPageViewModel)CurrentPage).MissingNote, FallbackValue={x:Null}}" />
                <HyperlinkButton Name="MissingLink"
                                 NavigateUri="{x:Static vm:FavoritesPageViewModel.MissingDocs}"
                                 AutomationProperties.Name="music-spin favorites --missing">
                    <TextBlock Text="music-spin favorites --missing" />
                </HyperlinkButton>
            </StackPanel>

            <Panel>
                <ContentControl Name="Page" Content="{Binding CurrentPage}" />
                <StackPanel Classes="emptyView" IsVisible="{Binding CurrentPage.EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Name="EmptyText" Classes="empty" Text="{Binding CurrentPage.EmptyText}" />
                    <!-- Favorites, empty: how to add one, with the heart itself (Inter has no ♡). -->
                    <StackPanel Name="EmptyHint"
                                Classes="emptyHint"
                                IsVisible="{Binding ((vm:FavoritesPageViewModel)CurrentPage).ShowsHowToAdd, FallbackValue=False}">
                        <TextBlock Classes="empty" Text="Click" />
                        <controls:Icon Classes="stroke emptyHeart" Data="{StaticResource Heart}" />
                        <TextBlock Classes="empty" Text="on a track to add it." />
                    </StackPanel>
                    <!-- An empty library (#31): Add a music folder, then the scan's progress until its albums appear. -->
                    <StackPanel Name="AddMusic" Classes="addMusic" IsVisible="{Binding CurrentPage.IsLibraryEmpty}">
                        <Button Name="AddMusicButton" Classes="accent pill" Command="{Binding Library.AddFolderCommand}">
                            <StackPanel>
                                <controls:Icon Data="{StaticResource Plus}" />
                                <TextBlock Text="Add a music folder" />
                            </StackPanel>
                        </Button>
                        <TextBlock Name="AddMusicProgress"
                                   Classes="empty"
                                   Text="{Binding LibraryScan.ProgressText}"
                                   IsVisible="{Binding LibraryScan.ProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </StackPanel>
            </Panel>
        </DockPanel>

        <!-- Now Playing, between the title bar and the player bar; it slides up from under the player bar. -->
        <controls:SlidePanel Name="NowPlayingLayer" Classes="nowPlaying" Grid.Row="1" Grid.ColumnSpan="2" IsOpen="{Binding NowPlaying.IsOpen}" IsFading="{Binding Scene.IsRunning}"
                             IsUnder="{Binding #QueueLayer.IsMoving}">
            <views:NowPlayingView Name="NowPlayingView" />
        </controls:SlidePanel>

        <!-- The queue drawer, over the content and Now Playing on the right; it slides in from the window's edge. -->
        <controls:SlidePanel Name="QueueLayer" Classes="queue" Grid.Row="1" Grid.ColumnSpan="2" IsOpen="{Binding QueueDrawer.IsOpen}">
            <Border Classes="queueDrawer">
                <views:QueueDrawerView Name="QueueDrawerView" DataContext="{Binding QueueDrawer}" />
            </Border>
        </controls:SlidePanel>

        <views:PlayerBar Name="PlayerBarView" Grid.Row="2" Grid.ColumnSpan="2" />

        <!-- Settings over the whole window; a click on the dim around it closes it. -->
        <Panel Name="SettingsLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Settings.IsOpen}">
            <Button Name="SettingsBackdrop"
                    Classes="backdrop"
                    Command="{Binding Settings.CloseCommand}"
                    AutomationProperties.Name="Close Settings" />
            <views:SettingsDialog Name="SettingsView" DataContext="{Binding Settings}" />
        </Panel>

        <!-- The menu, over everything, under the button that opened it (MainWindow.axaml.cs places it). -->
        <Canvas Name="MenuLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Menu.IsOpen}">
            <Border Name="MenuBox" Classes="menu">
                <StackPanel>
                    <!-- A confirmation's question, over its entries. -->
                    <TextBlock Name="MenuCaption"
                               Classes="menuCaption"
                               Text="{Binding Menu.Caption}"
                               IsVisible="{Binding Menu.Caption, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <ItemsControl Name="MenuEntries" ItemsSource="{Binding Menu.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:MenuEntryViewModel">
                                <Button Classes="menuEntry"
                                        Classes.destructive="{Binding IsDestructive}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Menu.ChooseCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding Label}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Label}" />
                                        <controls:Icon Grid.Column="1" Data="{StaticResource Check}" IsVisible="{Binding IsChosen}" />
                                        <controls:Icon Grid.Column="1" Classes="submenu" Data="{StaticResource ChevronRight}" IsVisible="{Binding HasSubmenu}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
