<!--
  The window (mockup: .window): title bar, sidebar | content, player bar. Sizes and looks are in Styles/; this file is
  structure and bindings only (tests/MusicSpin.Tests.Ui guards that).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MusicSpin.App.ViewModels"
        xmlns:views="using:MusicSpin.App.Views"
        xmlns:pages="using:MusicSpin.App.Views.Pages"
        xmlns:controls="using:MusicSpin.App.Controls"
        x:Class="MusicSpin.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Classes="shell"
        Title="Music Spin">
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Gesture="Space" Command="{Binding SpaceCommand}" />
        <KeyBinding Gesture="Ctrl+Right" Command="{Binding SeekForwardCommand}" />
        <KeyBinding Gesture="Ctrl+Left" Command="{Binding SeekBackCommand}" />
        <KeyBinding Gesture="Ctrl+Up" Command="{Binding VolumeUpCommand}" />
        <KeyBinding Gesture="Ctrl+Down" Command="{Binding VolumeDownCommand}" />
    </Window.KeyBindings>

    <Window.DataTemplates>
        <DataTemplate DataType="vm:AlbumsPageViewModel">
            <pages:AlbumsPage />
        </DataTemplate>
        <DataTemplate DataType="vm:TrackListPageViewModel">
            <pages:TracksPage />
        </DataTemplate>
        <DataTemplate DataType="vm:RadioPageViewModel">
            <pages:RadioPage />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid Name="ShellGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleBarHeight}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource PlayerBarHeight}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <views:TitleBar Name="TitleBarView" Grid.ColumnSpan="2" />

        <views:SidebarView Name="SidebarView" Grid.Row="1" DataContext="{Binding Sidebar}" />

        <DockPanel Name="ContentArea" Grid.Row="1" Grid.Column="1">
            <Border Name="Banner"
                    Classes="banner"
                    DockPanel.Dock="Top"
                    IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Name="BannerText" Text="{Binding Banner}" />
                    <Button Name="DismissBanner"
                            Grid.Column="1"
                            Command="{Binding DismissBannerCommand}"
                            ToolTip.Tip="Dismiss"
                            AutomationProperties.Name="Dismiss">
                        <controls:Icon Data="{StaticResource Close}" />
                    </Button>
                </Grid>
            </Border>

            <Grid Name="Toolbar" Classes="toolbar" DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
                <StackPanel Classes="pageHeading">
                    <TextBlock Name="PageTitle" Classes="pageTitle" Text="{Binding CurrentPage.Title}" />
                    <TextBlock Name="PageCount" Classes="pageCount" Text="{Binding CurrentPage.CountText}" />
                </StackPanel>
                <!-- Page-specific controls: the first template that fits the page; others show nothing. -->
                <ContentControl Name="PageActions" Grid.Column="1" Content="{Binding CurrentPage}" HorizontalContentAlignment="Stretch">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="vm:AlbumsPageViewModel">
                            <Panel>
                                <ListBox Name="ViewSwitch"
                                         Classes="viewSwitch"
                                         Theme="{StaticResource Segmented}"
                                         ItemsSource="{Binding Views}"
                                         SelectedItem="{Binding ViewChoice}"
                                         AutomationProperties.Name="View" />
                                <StackPanel Classes="sort">
                                    <Button Name="SortButton" Classes="dropdown" Command="{Binding OpenSortMenuCommand}" AutomationProperties.Name="Sort">
                                        <StackPanel>
                                            <TextBlock Text="Sort: " />
                                            <TextBlock Classes="chosen" Text="{Binding Sort}" />
                                            <controls:Icon Data="{StaticResource ChevronDown}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Name="GroupButton" Classes="dropdown" Command="{Binding OpenGroupMenuCommand}" AutomationProperties.Name="Group">
                                        <StackPanel>
                                            <TextBlock Text="Group: " />
                                            <TextBlock Classes="chosen" Text="{Binding Grouping}" />
                                            <controls:Icon Data="{StaticResource ChevronDown}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Panel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TracksPageViewModel">
                            <StackPanel Classes="sort">
                                <Button Name="SortButton" Classes="dropdown" Command="{Binding OpenSortMenuCommand}" AutomationProperties.Name="Sort">
                                    <StackPanel>
                                        <TextBlock Text="Sort: " />
                                        <TextBlock Classes="chosen" Text="{Binding Sort}" />
                                        <controls:Icon Data="{StaticResource ChevronDown}" />
                                    </StackPanel>
                                </Button>
                                <Button Name="GroupButton" Classes="dropdown" Command="{Binding OpenGroupMenuCommand}" AutomationProperties.Name="Group">
                                    <StackPanel>
                                        <TextBlock Text="Group: " />
                                        <TextBlock Classes="chosen" Text="{Binding Grouping}" />
                                        <controls:Icon Data="{StaticResource ChevronDown}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:TrackListPageViewModel">
                            <Button Name="PlayAll" Classes="accent" HorizontalAlignment="Left" Content="Play all" Command="{Binding PlayAllCommand}" />
                        </DataTemplate>
                        <DataTemplate DataType="vm:PageViewModel">
                            <Panel />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </Grid>

            <Panel>
                <ContentControl Name="Page" Content="{Binding CurrentPage}" />
                <TextBlock Name="EmptyText"
                           Classes="empty"
                           Text="{Binding CurrentPage.EmptyText}"
                           IsVisible="{Binding CurrentPage.EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Panel>
        </DockPanel>

        <views:PlayerBar Name="PlayerBarView" Grid.Row="2" Grid.ColumnSpan="2" />

        <!-- Settings over the whole window; a click on the dim around it closes it. -->
        <Panel Name="SettingsLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Settings.IsOpen}">
            <Button Name="SettingsBackdrop"
                    Classes="backdrop"
                    Command="{Binding Settings.CloseCommand}"
                    AutomationProperties.Name="Close Settings" />
            <views:SettingsDialog Name="SettingsView" DataContext="{Binding Settings}" />
        </Panel>

        <!-- The menu, over everything, under the button that opened it (MainWindow.axaml.cs places it). -->
        <Canvas Name="MenuLayer" Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding Menu.IsOpen}">
            <Border Name="MenuBox" Classes="menu">
                <ItemsControl Name="MenuEntries" ItemsSource="{Binding Menu.Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MenuEntryViewModel">
                            <Button Classes="menuEntry"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Menu.ChooseCommand}"
                                    CommandParameter="{Binding}"
                                    AutomationProperties.Name="{Binding Label}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Label}" />
                                    <controls:Icon Grid.Column="1" Data="{StaticResource Check}" IsVisible="{Binding IsChosen}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Canvas>
    </Grid>
</Window>
