<!--
  Tracks, and a playlist's tracks (mockup: .tlist): title, artist, album, duration. Clicking a track plays the list from it.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicSpin.App.ViewModels"
             x:Class="MusicSpin.App.Views.Pages.TracksPage"
             x:DataType="vm:TrackListPageViewModel">
    <ScrollViewer Name="Scroller" Classes="view">
        <ItemsControl Name="TrackList" ItemsSource="{Binding Tracks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:TrackItemViewModel">
                    <Button Classes="row"
                            Classes.playing="{Binding IsPlaying}"
                            Command="{Binding $parent[ItemsControl].((vm:TrackListPageViewModel)DataContext).PlayTrackCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{StaticResource RowDurationColumn}" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                            <TextBlock Grid.Column="1" Classes="rowCell" Text="{Binding Artist}" />
                            <TextBlock Grid.Column="2" Classes="rowCell" Text="{Binding Album}" />
                            <TextBlock Grid.Column="3" Classes="rowDuration" Text="{Binding Duration}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
