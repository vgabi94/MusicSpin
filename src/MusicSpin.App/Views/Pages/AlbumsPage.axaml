<!--
  Albums: a virtualized list, one row per album with its sleeve and record; clicking a row plays the album.
  (The Cards, Shelf and Crate views replace this list in their own issues.)
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MusicSpin.App.ViewModels"
             xmlns:controls="using:MusicSpin.App.Controls"
             x:Class="MusicSpin.App.Views.Pages.AlbumsPage"
             x:DataType="vm:AlbumsPageViewModel">
    <ScrollViewer Name="Scroller" Classes="view">
        <ItemsControl Name="AlbumList" ItemsSource="{Binding Albums}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AlbumItemViewModel">
                    <Button Classes="row"
                            Classes.playing="{Binding IsPlaying}"
                            Command="{Binding $parent[ItemsControl].((vm:AlbumsPageViewModel)DataContext).PlayAlbumCommand}"
                            CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Title}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource RowSleeveColumn}" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>
                            <Panel Classes="sleeve rowSleeve" Classes.playing="{Binding IsPlaying}">
                                <controls:VinylView Label="{Binding Cover}" Angle="{Binding DiscAngle}" />
                                <controls:CoverView Classes="flat" Source="{Binding Cover}" Title="{Binding Title}" Artist="{Binding Artist}" />
                            </Panel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                                <TextBlock Classes="rowSub" Text="{Binding Artist}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Classes="rowCell" Text="{Binding Details}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
