<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- Test method names use underscores; xUnit async void/ConfigureAwait rules are noise in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1861</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 4.x runs on Microsoft.Testing.Platform (see global.json "test.runner"); no VSTest adapter needed. -->
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
